{
  "name": "@colorust/wasm",
  "version": "1.0.0",
  "description": "TypeScript SDK and WebAssembly bindings for Colorust perceptual color science core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "tsc",
    "build": "tsc",
    "build:wasm:node": "wasm-pack build --target nodejs --out-dir pkg-node",
    "test": "node --test test/differential.mjs"
  },
  "keywords": [
    "oklch",
    "apca",
    "wcag",
    "accessibility",
    "contrast",
    "color-science",
    "webassembly",
    "rust"
  ],
  "author": "Jonas Monteiro",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
