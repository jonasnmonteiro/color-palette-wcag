---
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Colorust Auditor | WCAG 2.1 & WCAG 3.0 APCA Contrast Auditor</title>
  <meta name="description" content="Auditor for WCAG 2.1, WCAG 3.0 APCA, and CIEDE2000 color difference." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function() {
      try {
        const theme = localStorage.getItem('colorust-app-theme');
        if (theme) document.documentElement.setAttribute('data-theme', theme);
      } catch {}
    })();
  </script>
</head>
<body>
  <Header />

  <main class="container">
    <section class="auditor-hero">
      <h1 class="hero-title">
        Accessibility & <span class="gradient-text">Contrast Auditor</span>
      </h1>
      <p class="hero-desc">
        Comprehensive side-by-side compliance verification comparing legacy WCAG 2.1 relative luminance against WCAG 3.0 Advanced Perceptual Contrast Algorithm (APCA).
      </p>
    </section>

    <div class="auditor-grid">
      <!-- Pair Input & Live Card -->
      <div class="glass-panel audit-panel">
        <h2 class="card-title">Color Pair Inputs</h2>

        <div class="color-inputs-duo">
          <div class="color-field">
            <label class="field-label" for="fg-input">Text Foreground</label>
            <div class="input-with-swatch">
              <input type="color" id="fg-picker" value="#3B82F6" class="color-dot-picker" />
              <input type="text" id="fg-input" value="#3B82F6" class="text-input" spellcheck="false" />
            </div>
          </div>

          <div class="color-field">
            <label class="field-label" for="bg-input">Background</label>
            <div class="input-with-swatch">
              <input type="color" id="bg-picker" value="#0A0D14" class="color-dot-picker" />
              <input type="text" id="bg-input" value="#0A0D14" class="text-input" spellcheck="false" />
            </div>
          </div>
        </div>

        <div class="audit-preview-box" id="audit-preview-box">
          <h3 class="preview-headline" id="preview-headline">Headline Typography Sample (24px)</h3>
          <p class="preview-body" id="preview-body">
            Body text readability is evaluated using spatial frequency models and cone photoreceptor saturation curves.
          </p>
        </div>
      </div>

      <!-- Compliance Metrics -->
      <div class="glass-panel audit-panel">
        <h2 class="card-title">Dual Audit Metrics</h2>

        <div class="metrics-split">
          <!-- WCAG 2.1 -->
          <div class="metric-column">
            <div class="column-header">
              <span class="column-name">WCAG 2.1</span>
              <span class="column-badge" id="wcag-overall-badge">AA PASS</span>
            </div>
            <div class="huge-metric" id="wcag-ratio-val">8.42:1</div>
            <div class="criteria-list">
              <div class="criteria-row">
                <span>Normal Text AA (4.5:1)</span>
                <span class="badge badge-pass" id="badge-wcag-normal-aa">PASS</span>
              </div>
              <div class="criteria-row">
                <span>Large Text AA (3.0:1)</span>
                <span class="badge badge-pass" id="badge-wcag-large-aa">PASS</span>
              </div>
              <div class="criteria-row">
                <span>Normal Text AAA (7.0:1)</span>
                <span class="badge badge-pass" id="badge-wcag-normal-aaa">PASS</span>
              </div>
              <div class="criteria-row">
                <span>Large Text AAA (4.5:1)</span>
                <span class="badge badge-pass" id="badge-wcag-large-aaa">PASS</span>
              </div>
            </div>
          </div>

          <!-- APCA WCAG 3.0 -->
          <div class="metric-column">
            <div class="column-header">
              <span class="column-name">APCA (WCAG 3.0)</span>
              <span class="column-badge" id="apca-overall-badge">BODY PASS</span>
            </div>
            <div class="huge-metric" id="apca-lc-val">+84.5 Lc</div>
            <div class="criteria-list">
              <div class="criteria-row">
                <span>Body Content (|Lc| ≥ 75)</span>
                <span class="badge badge-pass" id="badge-apca-body">PASS</span>
              </div>
              <div class="criteria-row">
                <span>Fluent Text (|Lc| ≥ 60)</span>
                <span class="badge badge-pass" id="badge-apca-fluent">PASS</span>
              </div>
              <div class="criteria-row">
                <span>Large Text (|Lc| ≥ 45)</span>
                <span class="badge badge-pass" id="badge-apca-large">PASS</span>
              </div>
              <div class="criteria-row">
                <span>Non-Text UI Elements (|Lc| ≥ 15)</span>
                <span class="badge badge-pass" id="badge-apca-nontext">PASS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CVD Contrast Simulation Section -->
    <div class="glass-panel cvd-auditor-panel">
      <div class="card-header">
        <div>
          <h2 class="card-title">Simulação de Daltonismo & Degradação de Contraste (CVD)</h2>
          <p class="card-subtitle">Auditoria das razões de contraste quando texto e fundo são percebidos sob deficiências de fotorreceptores cônicos</p>
        </div>
        <span class="badge badge-neutral">Modelo Machado (2009)</span>
      </div>

      <div class="cvd-audit-cards-grid" id="cvd-audit-cards-grid"></div>
    </div>
  </main>

  <script>
    import { auditContrastHex, auditCvdContrast, CvdType } from '../../../wasm/src/index';

    const fgInput = document.getElementById('fg-input') as HTMLInputElement;
    const bgInput = document.getElementById('bg-input') as HTMLInputElement;
    const fgPicker = document.getElementById('fg-picker') as HTMLInputElement;
    const bgPicker = document.getElementById('bg-picker') as HTMLInputElement;

    const previewBox = document.getElementById('audit-preview-box') as HTMLElement;
    const previewHeadline = document.getElementById('preview-headline') as HTMLElement;
    const previewBody = document.getElementById('preview-body') as HTMLElement;

    const wcagRatioVal = document.getElementById('wcag-ratio-val') as HTMLElement;
    const apcaLcVal = document.getElementById('apca-lc-val') as HTMLElement;

    const badgeWcagNormalAa = document.getElementById('badge-wcag-normal-aa') as HTMLElement;
    const badgeWcagLargeAa = document.getElementById('badge-wcag-large-aa') as HTMLElement;
    const badgeWcagNormalAaa = document.getElementById('badge-wcag-normal-aaa') as HTMLElement;
    const badgeWcagLargeAaa = document.getElementById('badge-wcag-large-aaa') as HTMLElement;

    const badgeApcaBody = document.getElementById('badge-apca-body') as HTMLElement;
    const badgeApcaFluent = document.getElementById('badge-apca-fluent') as HTMLElement;
    const badgeApcaLarge = document.getElementById('badge-apca-large') as HTMLElement;
    const badgeApcaNonText = document.getElementById('badge-apca-nontext') as HTMLElement;

    const cvdAuditCardsGrid = document.getElementById('cvd-audit-cards-grid') as HTMLElement;

    function renderAudit() {
      const fg = fgInput.value;
      const bg = bgInput.value;

      previewBox.style.backgroundColor = bg;
      previewHeadline.style.color = fg;
      previewBody.style.color = fg;

      const result = auditContrastHex(fg, bg);
      if (!result) return;

      wcagRatioVal.textContent = `${result.wcag.ratio.toFixed(2)}:1`;
      apcaLcVal.textContent = `${result.apca.lc > 0 ? '+' : ''}${result.apca.lc.toFixed(1)} Lc`;

      const updateBadge = (el: HTMLElement, pass: boolean) => {
        el.className = `badge ${pass ? 'badge-pass' : 'badge-fail'}`;
        el.textContent = pass ? 'PASS' : 'FAIL';
      };

      updateBadge(badgeWcagNormalAa, result.wcag.normal_aa);
      updateBadge(badgeWcagLargeAa, result.wcag.large_aa);
      updateBadge(badgeWcagNormalAaa, result.wcag.normal_aaa);
      updateBadge(badgeWcagLargeAaa, result.wcag.large_aaa);

      updateBadge(badgeApcaBody, result.apca.body_text);
      updateBadge(badgeApcaFluent, result.apca.fluent_text);
      updateBadge(badgeApcaLarge, result.apca.large_text);
      updateBadge(badgeApcaNonText, result.apca.non_text);

      // Render CVD Matrix Cards
      if (cvdAuditCardsGrid) {
        cvdAuditCardsGrid.innerHTML = '';
        const cvdList: { type: CvdType; name: string; desc: string; pop: string }[] = [
          { type: 'protanopia', name: 'Protanopia', desc: 'Perda do cone L (vermelho)', pop: '1.0% dos homens' },
          { type: 'deuteranopia', name: 'Deuteranopia', desc: 'Perda do cone M (verde)', pop: '5.0% dos homens' },
          { type: 'tritanopia', name: 'Tritanopia', desc: 'Perda do cone S (azul)', pop: '<0.01% da população' },
          { type: 'achromatopsia', name: 'Acromatopsia', desc: 'Monocromacia total (luminância)', pop: '0.003% da população' },
        ];

        cvdList.forEach((cvd) => {
          const cvdRes = auditCvdContrast(fg, bg, cvd.type, 1.0);
          if (!cvdRes) return;

          const card = document.createElement('div');
          card.className = 'cvd-audit-card';
          card.innerHTML = `
            <div class="cvd-card-top">
              <div>
                <div class="cvd-card-title">${cvd.name}</div>
                <div class="cvd-card-desc">${cvd.desc} (${cvd.pop})</div>
              </div>
              <span class="badge ${cvdRes.wcag.normal_aa ? 'badge-pass' : 'badge-fail'}">
                ${cvdRes.wcag.normal_aa ? 'AA PASS' : 'AA FAIL'}
              </span>
            </div>

            <div class="cvd-sample-box" style="background-color: ${cvdRes.simulated_bg}; color: ${cvdRes.simulated_fg}">
              <div class="cvd-sample-head">Aa Texto Simulado</div>
              <div class="cvd-sample-body">Legibilidade perceptual sob ${cvd.name}.</div>
            </div>

            <div class="cvd-metrics-row">
              <div class="cvd-metric-box">
                <span class="cvd-m-label">Simulado</span>
                <span class="cvd-m-val">${cvdRes.simulated_fg} / ${cvdRes.simulated_bg}</span>
              </div>
              <div class="cvd-metric-box">
                <span class="cvd-m-label">Razão WCAG</span>
                <span class="cvd-m-val">${cvdRes.wcag.ratio.toFixed(2)}:1</span>
              </div>
              <div class="cvd-metric-box">
                <span class="cvd-m-label">APCA Lc</span>
                <span class="cvd-m-val">${cvdRes.apca.lc > 0 ? '+' : ''}${cvdRes.apca.lc.toFixed(1)}</span>
              </div>
            </div>
          `;

          cvdAuditCardsGrid.appendChild(card);
        });
      }
    }

    fgInput.addEventListener('input', () => {
      fgPicker.value = fgInput.value;
      renderAudit();
    });

    bgInput.addEventListener('input', () => {
      bgPicker.value = bgInput.value;
      renderAudit();
    });

    fgPicker.addEventListener('input', () => {
      fgInput.value = fgPicker.value.toUpperCase();
      renderAudit();
    });

    bgPicker.addEventListener('input', () => {
      bgInput.value = bgPicker.value.toUpperCase();
      renderAudit();
    });

    renderAudit();
  </script>

  <style>
    .auditor-hero {
      text-align: center;
      padding: 48px 0 24px 0;
      max-width: 800px;
      margin: 0 auto;
    }

    .auditor-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin: 32px 0 64px 0;
    }

    .audit-panel {
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .color-inputs-duo {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .color-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .input-with-swatch {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 4px 10px;
    }

    .color-dot-picker {
      width: 28px;
      height: 28px;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      background: transparent;
    }

    .input-with-swatch .text-input {
      border: none;
      background: transparent;
      padding: 6px 0;
      font-family: var(--font-mono);
      font-weight: 600;
      color: var(--text-primary);
    }

    .audit-preview-box {
      border-radius: var(--radius-md);
      padding: 24px;
      border: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 180px;
    }

    .preview-headline {
      font-size: 22px;
      font-weight: 700;
    }

    .preview-body {
      font-size: 14px;
      line-height: 1.6;
    }

    .metrics-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .metric-column {
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .column-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .column-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-secondary);
    }

    .column-badge {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      background: color-mix(in srgb, var(--color-success) 20%, transparent);
      color: var(--color-success);
    }

    .huge-metric {
      font-size: 28px;
      font-weight: 800;
      font-family: var(--font-mono);
      color: var(--text-primary);
    }

    .criteria-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .criteria-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .cvd-auditor-panel {
      padding: 28px;
      margin-bottom: 64px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .cvd-audit-cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .cvd-audit-card {
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .cvd-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 8px;
    }

    .cvd-card-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .cvd-card-desc {
      font-size: 11px;
      color: var(--text-muted);
    }

    .cvd-sample-box {
      padding: 14px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .cvd-sample-head {
      font-size: 14px;
      font-weight: 700;
    }

    .cvd-sample-body {
      font-size: 11px;
      opacity: 0.9;
    }

    .cvd-metrics-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .cvd-metric-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      padding: 6px 8px;
      border-radius: var(--radius-sm);
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .cvd-m-label {
      font-size: 9px;
      text-transform: uppercase;
      color: var(--text-muted);
      font-weight: 700;
    }

    .cvd-m-val {
      font-size: 11px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-primary);
    }

    @media (max-width: 1100px) {
      .cvd-audit-cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 960px) {
      .auditor-grid, .metrics-split {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .cvd-audit-cards-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</body>
</html>
