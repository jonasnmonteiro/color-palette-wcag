---
import Header from '../components/Header.astro';
import ColorStudioIsland from '../components/ColorStudioIsland.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Colorust Studio | Perceptual OKLCH Palette Generator & WCAG/APCA Auditor</title>
  <meta name="description" content="Ultra-fast perceptual color science suite, OKLCH palette generator, WCAG 2.1 & WCAG 3.0 APCA contrast auditor, and multi-format design token exporter." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline src={`${import.meta.env.BASE_URL}theme-boot.js`}></script>
</head>
<body>
  <Header />

  <main class="container">
    <section class="hero-section">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Perceptual Color Science Engine
      </div>
      <h1 class="hero-title">
        Next-Gen Palette Studio & <span class="gradient-text">Accessibility Auditor</span>
      </h1>
      <p class="hero-desc">
        Engineered with OKLCH uniform color space, CIEDE2000 perceptual delta, and WCAG 3.0 APCA modern readability algorithms. Derive production-ready design tokens in seconds.
      </p>
    </section>

    <ColorStudioIsland />
  </main>

  <footer class="studio-footer">
    <div class="container footer-container">
      <p>© 2026 Colorust Suite. Clean-room engineered for high-performance color science.</p>
      <div class="footer-links">
        <a href="https://www.w3.org/WAI/GL/task-forces/silver/wiki/Visual_Contrast_Subgroup" target="_blank" rel="noopener">APCA W3C Silver</a>
        <a href="https://bottosson.github.io/posts/oklab/" target="_blank" rel="noopener">OKLab Color Space</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .hero-section {
    text-align: center;
    padding: 48px 0 16px 0;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--brand-primary, #3B82F6) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-primary, #3B82F6) 30%, transparent);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-light, #60A5FA);
    margin-bottom: 20px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-light, #60A5FA);
  }

  .hero-title {
    font-size: 44px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .hero-desc {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .studio-footer {
    border-top: 1px solid var(--border-subtle);
    padding: 32px 0;
    margin-top: 64px;
    background: color-mix(in srgb, var(--bg-app, #0A0D14) 60%, transparent);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 16px 0 6px 0;
    }
    .hero-badge {
      margin-bottom: 8px;
      font-size: 11px;
      padding: 4px 10px;
    }
    .hero-title {
      font-size: 22px;
      margin-bottom: 6px;
      line-height: 1.2;
    }
    .hero-desc {
      font-size: 12px;
      line-height: 1.4;
      display: none;
    }
    .footer-container {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
