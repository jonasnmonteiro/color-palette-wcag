---
---

<div class="studio-wrapper" id="aura-studio-app">
  <!-- Top Split Section: Cor Base (Color Wheel) & A Paleta (Swatch Cards) -->
  <div class="studio-main-grid">
    <!-- Left Card: COR BASE / Chromatic Wheel -->
    <div class="glass-panel wheel-card-box">
      <div class="card-top-title">
        <span class="card-tag-title">COR BASE</span>
        <div class="harmony-rule-pill" id="current-harmony-label">Análogo</div>
      </div>

      <!-- Color Wheel Canvas, Center Hub & Interactive Pins -->
      <div class="wheel-outer-container">
        <div class="wheel-interactive-stage" id="wheel-interactive-stage">
          <canvas id="wheel-canvas" width="600" height="600" class="chromatic-canvas"></canvas>
          <svg id="wheel-svg-lines" class="chromatic-svg-overlay" width="300" height="300"></svg>
          <div id="wheel-pins-layer" class="chromatic-pins-layer"></div>
          <div class="wheel-center-hub"></div>
        </div>
      </div>

      <!-- Active Base Hex Readout & Quick Actions -->
      <div class="base-control-bar">
        <div class="base-swatch-box">
          <div class="base-color-square" id="base-color-square">
            <input type="color" id="base-native-picker" value="#3B82F6" class="hidden-native-picker" />
          </div>
          <div class="base-hex-display">
            <span class="base-hex-hash">#</span>
            <input type="text" id="base-hex-input" value="3B82F6" class="base-hex-field" spellcheck="false" maxlength="6" />
          </div>
        </div>

        <div class="base-buttons-row">
          <button class="btn-action-pill" id="eyedropper-btn" title="Pick color from screen">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 11l-8-8-8.5 8.5a2.12 2.12 0 0 0 0 3l2 2a2.12 2.12 0 0 0 3 0L16 8l3 3z"></path>
              <path d="M18 13l4 4-2 2-4-4"></path>
              <circle cx="2" cy="22" r="1"></circle>
            </svg>
            Conta-gotas
          </button>
          <button class="btn-action-pill" id="randomize-palette-btn" title="Generate random harmonic palette">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 3 21 3 21 8"></polyline>
              <line x1="4" y1="20" x2="21" y2="3"></line>
              <polyline points="21 16 21 21 16 21"></polyline>
              <line x1="15" y1="15" x2="21" y2="21"></line>
              <line x1="4" y1="4" x2="9" y2="9"></line>
            </svg>
            Aleatória
          </button>
        </div>
      </div>

      <!-- Harmony Mode Buttons -->
      <div class="harmony-modes-wrapper">
        <label class="sub-label">Regra Harmônica (OKLCH)</label>
        <div class="harmony-tags-grid" id="harmony-buttons">
          <button class="harmony-tag-btn active" data-mode="analogous">Análogo</button>
          <button class="harmony-tag-btn" data-mode="monochromatic">Monocromático</button>
          <button class="harmony-tag-btn" data-mode="triadic">Tríade</button>
          <button class="harmony-tag-btn" data-mode="complementary">Complementar</button>
          <button class="harmony-tag-btn" data-mode="split-complementary">Split-Comp</button>
          <button class="harmony-tag-btn" data-mode="tetradic">Tetradic</button>
          <button class="harmony-tag-btn" data-mode="square">Quadrado</button>
          <button class="harmony-tag-btn" data-mode="custom">Livre (Custom)</button>
        </div>
      </div>

      <!-- Image Extraction Dropzone -->
      <div class="image-extractor-box">
        <label class="image-dropzone-pill" for="image-file-input">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>Carregar Imagem para Extrair Paleta</span>
          <input type="file" id="image-file-input" accept="image/*" class="file-hidden-input" />
        </label>
        <canvas id="extract-canvas" style="display:none;"></canvas>
      </div>
    </div>

    <!-- Right Card: A PALETA / Swatches List -->
    <div class="glass-panel palette-card-box">
      <div class="card-top-title">
        <span class="card-tag-title">A PALETA</span>
        <div class="palette-top-tools">
          <span class="drag-hint-pill">Arraste os cards para reordenar</span>
          <button class="btn-action-pill" id="add-swatch-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Adicionar Cor
          </button>
          <span class="swatches-count-pill" id="swatches-count-badge">5 Cores</span>
        </div>
      </div>

      <!-- Vision Mode / CVD Simulator Bar -->
      <div class="cvd-selector-container">
        <div class="cvd-header-meta">
          <span class="sub-label">Simulação de Daltonismo (CVD)</span>
          <span class="cvd-active-status" id="cvd-active-label">Visão Padrão</span>
        </div>
        <div class="cvd-modes-buttons" id="cvd-mode-buttons">
          <button class="cvd-mode-btn active" data-cvd="normal">Padrão</button>
          <button class="cvd-mode-btn" data-cvd="protanopia">Protanopia <span class="cvd-sub-badge">Sem L</span></button>
          <button class="cvd-mode-btn" data-cvd="deuteranopia">Deuteranopia <span class="cvd-sub-badge">Sem M</span></button>
          <button class="cvd-mode-btn" data-cvd="tritanopia">Tritanopia <span class="cvd-sub-badge">Sem S</span></button>
          <button class="cvd-mode-btn" data-cvd="achromatopsia">Acromatopsia <span class="cvd-sub-badge">Mono</span></button>
        </div>
      </div>

      <!-- Vertical List of Swatches Cards with Drag and Drop -->
      <div class="palette-swatches-list" id="palette-swatches-list"></div>

      <!-- Footer Action -->
      <div class="palette-footer-row">
        <a href="#token-exporter-section" class="btn-primary export-anchor-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Exportar Tokens de Design
        </a>
      </div>
    </div>
  </div>

  <!-- CVD Multimodal Spectral Matrix Comparison Panel -->
  <div class="glass-panel cvd-matrix-panel">
    <div class="card-header">
      <div>
        <h2 class="card-title">Matriz Multimodal de Daltonismo (Machado 2009 / Brettel 1997)</h2>
        <p class="card-subtitle">Auditoria visual e espectral simultânea de toda a paleta ativa nos 4 espaços de deficiência visual</p>
      </div>
      <span class="badge badge-neutral" id="cvd-matrix-badge">Simulação 100% Espectral</span>
    </div>
    <div class="cvd-matrix-grid" id="cvd-matrix-grid"></div>
  </div>

  <!-- Bottom Section: Auditor Gates, UI Preview, and Multi-Format Token Exporter -->
  <div class="studio-bottom-grid" id="token-exporter-section">
    <!-- Left Column: Contrast Auditor Gates & Dual Inks -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Auditoria de Acessibilidade & APCA</h2>
        <span class="badge badge-pass" id="global-wcag-badge">WCAG 2.1 AA</span>
      </div>

      <div class="contrast-gates-grid">
        <div class="contrast-gate-box" id="gate-on-white">
          <div class="gate-title">Contraste no Branco (#FFFFFF)</div>
          <div class="gate-metrics">
            <div class="gate-metric">
              <span class="metric-val" id="metric-wcag-white">4.5:1</span>
              <span class="metric-label">WCAG 2.1</span>
            </div>
            <div class="gate-metric">
              <span class="metric-val" id="metric-apca-white">-78.2</span>
              <span class="metric-label">APCA Lc</span>
            </div>
          </div>
          <div class="gate-badges" id="badges-white"></div>
        </div>

        <div class="contrast-gate-box" id="gate-on-black">
          <div class="gate-title">Contraste no Escuro (#0A0D14)</div>
          <div class="gate-metrics">
            <div class="gate-metric">
              <span class="metric-val" id="metric-wcag-black">8.4:1</span>
              <span class="metric-label">WCAG 2.1</span>
            </div>
            <div class="gate-metric">
              <span class="metric-val" id="metric-apca-black">+84.5</span>
              <span class="metric-label">APCA Lc</span>
            </div>
          </div>
          <div class="gate-badges" id="badges-black"></div>
        </div>
      </div>

      <div class="ink-recommendation-box">
        <div class="ink-meta">
          <span class="ink-label">Tinta de Texto Ideal (Dual Inks)</span>
          <span class="ink-reason" id="ink-reason-text">Maior legibilidade perceptual calculada</span>
        </div>
        <div class="ink-pill" id="recommended-ink-pill">
          <span class="ink-pill-dot" id="ink-dot"></span>
          <span id="ink-name-text">Tinta Branca (#FFFFFF)</span>
        </div>
      </div>
    </div>

    <!-- Middle Column: Live Component Preview -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Preview de Componentes Semânticos</h2>
        <span class="badge badge-neutral">Design System</span>
      </div>

      <div class="preview-surface" id="preview-surface">
        <div class="preview-row">
          <button class="preview-btn-primary" id="preview-btn-brand">Botão Principal</button>
          <button class="preview-btn-secondary" id="preview-btn-subtle">Ação Secundária</button>
        </div>

        <div class="preview-card" id="preview-card-box">
          <div class="preview-card-header">
            <span class="preview-card-badge" id="preview-card-badge">PRO THEME</span>
            <span class="preview-card-title">Canvas de Componente</span>
          </div>
          <p class="preview-card-desc">Tokens semânticos sincronizados em tempo real com o disco cromático OKLCH.</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Token Exporter -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Exportador de Tokens</h2>
        <button class="btn-secondary copy-btn" id="copy-tokens-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copiar Código
        </button>
      </div>

      <div class="token-tabs" id="token-format-tabs">
        <button class="token-tab active" data-format="css">CSS</button>
        <button class="token-tab" data-format="tailwind-v4">Tailwind v4</button>
        <button class="token-tab" data-format="tailwind-v3">Tailwind v3</button>
        <button class="token-tab" data-format="figma-tokens">Figma DTCG</button>
        <button class="token-tab" data-format="style-dictionary">Style Dict</button>
        <button class="token-tab" data-format="swift">SwiftUI</button>
        <button class="token-tab" data-format="android-xml">Android XML</button>
      </div>

      <div class="code-viewer-container">
        <pre class="code-block"><code id="tokens-code-output">Loading tokens...</code></pre>
      </div>

      <div class="download-footer">
        <button class="btn-primary download-btn" id="download-tokens-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Baixar Tokens
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    auditContrastHex,
    auditCvdContrast,
    exportTokens,
    findGamutCusp,
    generateDesignTokens,
    generateHarmony,
    hexToOklch,
    isInGamut,
    oklchToHex,
    parseHex,
    quantizeImage,
    rgbToHex,
    simulateCvd,
    CvdType,
  } from '../../../wasm/src/index';

  interface PaletteItem {
    id: string;
    hex: string;
    l: number;
    c: number;
    h: number;
    isBase: boolean;
    isLocked: boolean;
  }

  let palette: PaletteItem[] = [];
  let currentHarmony = 'analogous';
  let currentFormat = 'css';
  let currentCvdMode: 'normal' | 'protanopia' | 'deuteranopia' | 'tritanopia' | 'achromatopsia' = 'normal';
  let baseIndex = 0;
  let draggedCardIndex: number | null = null;

  const wheelCanvas = document.getElementById('wheel-canvas') as HTMLCanvasElement;
  const wheelSvgLines = document.getElementById('wheel-svg-lines') as unknown as SVGSVGElement;
  const wheelPinsLayer = document.getElementById('wheel-pins-layer') as HTMLDivElement;
  const wheelInteractiveStage = document.getElementById('wheel-interactive-stage') as HTMLDivElement;

  const baseColorSquare = document.getElementById('base-color-square') as HTMLElement;
  const baseNativePicker = document.getElementById('base-native-picker') as HTMLInputElement;
  const baseHexInput = document.getElementById('base-hex-input') as HTMLInputElement;
  const currentHarmonyLabel = document.getElementById('current-harmony-label') as HTMLElement;

  const eyedropperBtn = document.getElementById('eyedropper-btn') as HTMLButtonElement;
  const randomizeBtn = document.getElementById('randomize-palette-btn') as HTMLButtonElement;
  const addSwatchBtn = document.getElementById('add-swatch-btn') as HTMLButtonElement;
  const swatchesCountBadge = document.getElementById('swatches-count-badge') as HTMLElement;
  const paletteSwatchesList = document.getElementById('palette-swatches-list') as HTMLDivElement;
  const harmonyButtons = document.querySelectorAll('.harmony-tag-btn');

  const cvdModeButtons = document.querySelectorAll('.cvd-mode-btn');
  const cvdActiveLabel = document.getElementById('cvd-active-label') as HTMLElement;
  const cvdMatrixGrid = document.getElementById('cvd-matrix-grid') as HTMLDivElement;

  const metricWcagWhite = document.getElementById('metric-wcag-white') as HTMLElement;
  const metricApcaWhite = document.getElementById('metric-apca-white') as HTMLElement;
  const badgesWhite = document.getElementById('badges-white') as HTMLElement;
  const metricWcagBlack = document.getElementById('metric-wcag-black') as HTMLElement;
  const metricApcaBlack = document.getElementById('metric-apca-black') as HTMLElement;
  const badgesBlack = document.getElementById('badges-black') as HTMLElement;

  const inkNameText = document.getElementById('ink-name-text') as HTMLElement;
  const inkDot = document.getElementById('ink-dot') as HTMLElement;

  const previewSurface = document.getElementById('preview-surface') as HTMLElement;
  const previewBtnBrand = document.getElementById('preview-btn-brand') as HTMLElement;
  const previewBtnSubtle = document.getElementById('preview-btn-subtle') as HTMLElement;
  const previewCardBox = document.getElementById('preview-card-box') as HTMLElement;
  const previewCardBadge = document.getElementById('preview-card-badge') as HTMLElement;

  const tokensCodeOutput = document.getElementById('tokens-code-output') as HTMLElement;
  const copyTokensBtn = document.getElementById('copy-tokens-btn') as HTMLButtonElement;
  const downloadTokensBtn = document.getElementById('download-tokens-btn') as HTMLButtonElement;
  const tokenTabs = document.querySelectorAll('.token-tab');

  const imageFileInput = document.getElementById('image-file-input') as HTMLInputElement;
  const extractCanvas = document.getElementById('extract-canvas') as HTMLCanvasElement;

  function initDefaultPalette() {
    const baseHex = '#3B82F6';
    const baseOk = hexToOklch(baseHex)!;

    palette = [
      { id: 'p0', hex: '#009FCA', l: 0.62, c: 0.18, h: (baseOk.h - 30 + 360) % 360, isBase: false, isLocked: false },
      { id: 'p1', hex: '#238FF0', l: 0.62, c: 0.19, h: (baseOk.h - 15 + 360) % 360, isBase: false, isLocked: false },
      { id: 'p2', hex: '#3B82F6', l: 0.62, c: 0.19, h: baseOk.h, isBase: true, isLocked: false },
      { id: 'p3', hex: '#6374F5', l: 0.62, c: 0.19, h: (baseOk.h + 15 + 360) % 360, isBase: false, isLocked: false },
      { id: 'p4', hex: '#8762EE', l: 0.62, c: 0.18, h: (baseOk.h + 30 + 360) % 360, isBase: false, isLocked: false },
    ];
    baseIndex = 2;
    renderAll();
  }

  function drawWheelCanvas() {
    const ctx = wheelCanvas.getContext('2d');
    if (!ctx) return;

    const width = wheelCanvas.width;
    const height = wheelCanvas.height;
    const cx = width / 2;
    const cy = height / 2;
    const radius = width / 2 - 16;

    ctx.clearRect(0, 0, width, height);

    for (let angle = 0; angle < 360; angle += 1) {
      const startAngle = ((angle - 1.5) * Math.PI) / 180;
      const endAngle = ((angle + 1.5) * Math.PI) / 180;

      const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
      const hexOuter = oklchToHex(0.68, 0.28, angle);
      const hexInner = oklchToHex(0.95, 0.01, angle);

      grad.addColorStop(0, hexInner);
      grad.addColorStop(0.4, oklchToHex(0.82, 0.14, angle));
      grad.addColorStop(1, hexOuter);

      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();
    }

    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
    ctx.lineWidth = 3;
    ctx.stroke();

    for (let frac of [0.33, 0.66, 1.0]) {
      ctx.beginPath();
      ctx.arc(cx, cy, radius * frac, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }
  }

  function polarToStageCoords(h: number, c: number) {
    const stageWidth = 300;
    const stageHeight = 300;
    const cx = stageWidth / 2;
    const cy = stageHeight / 2;
    const maxRadius = stageWidth / 2 - 14;
    const r = Math.min(1.0, Math.max(0.05, c / 0.28)) * maxRadius;
    const rad = (h * Math.PI) / 180;
    return {
      x: cx + r * Math.cos(rad),
      y: cy + r * Math.sin(rad),
    };
  }

  function stageCoordsToPolar(x: number, y: number) {
    const stageWidth = 300;
    const stageHeight = 300;
    const cx = stageWidth / 2;
    const cy = stageHeight / 2;
    const maxRadius = stageWidth / 2 - 14;
    const dx = x - cx;
    const dy = y - cy;
    let rad = Math.atan2(dy, dx);
    let h = (rad * 180) / Math.PI;
    if (h < 0) h += 360;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const c = Math.min(0.37, Math.max(0.01, (dist / maxRadius) * 0.28));
    return { h, c };
  }

  function renderWheelPins() {
    wheelPinsLayer.innerHTML = '';
    wheelSvgLines.innerHTML = '';

    const stageWidth = 300;
    const stageHeight = 300;
    const cx = stageWidth / 2;
    const cy = stageHeight / 2;

    let linesHtml = '';

    palette.forEach((item) => {
      const pos = polarToStageCoords(item.h, item.c);
      const strokeColor = item.isLocked ? '#F59E0B' : item.isBase ? 'rgba(255, 255, 255, 0.85)' : 'rgba(255, 255, 255, 0.45)';
      const strokeWidth = item.isBase ? '2.5' : '1.5';
      const dashArray = item.isLocked ? '4 3' : 'none';

      linesHtml += `<line x1="${cx}" y1="${cy}" x2="${pos.x}" y2="${pos.y}" stroke="${strokeColor}" stroke-width="${strokeWidth}" stroke-dasharray="${dashArray}" />`;
    });

    if (currentHarmony === 'analogous') {
      const sorted = [...palette].sort((a, b) => a.h - b.h);
      for (let i = 0; i < sorted.length - 1; i++) {
        const p1 = polarToStageCoords(sorted[i].h, sorted[i].c);
        const p2 = polarToStageCoords(sorted[i + 1].h, sorted[i + 1].c);
        linesHtml += `<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="rgba(255, 255, 255, 0.35)" stroke-width="1.5" stroke-dasharray="2 2" />`;
      }
    } else if (currentHarmony === 'triadic' || currentHarmony === 'tetradic' || currentHarmony === 'square') {
      const sorted = [...palette].sort((a, b) => a.h - b.h);
      for (let i = 0; i < sorted.length; i++) {
        const p1 = polarToStageCoords(sorted[i].h, sorted[i].c);
        const p2 = polarToStageCoords(sorted[(i + 1) % sorted.length].h, sorted[(i + 1) % sorted.length].c);
        linesHtml += `<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="rgba(255, 255, 255, 0.35)" stroke-width="1.5" />`;
      }
    }

    wheelSvgLines.innerHTML = linesHtml;

    palette.forEach((item, idx) => {
      const pos = polarToStageCoords(item.h, item.c);
      const pin = document.createElement('div');
      pin.className = `chroma-pin ${item.isBase ? 'pin-is-base' : ''} ${item.isLocked ? 'pin-is-locked' : ''}`;
      pin.style.left = `${pos.x}px`;
      pin.style.top = `${pos.y}px`;
      pin.style.backgroundColor = item.hex;
      pin.setAttribute('data-index', idx.toString());

      if (item.isBase) {
        pin.innerHTML = `<span class="pin-inner-dot"></span>`;
      } else if (item.isLocked) {
        pin.innerHTML = `<span class="pin-lock-symbol">🔒</span>`;
      }

      wheelPinsLayer.appendChild(pin);
    });
  }

  function applyHarmonyConstellation(newBaseH: number, newBaseC: number) {
    const base = palette[baseIndex] || palette[0];
    base.h = newBaseH;
    base.c = newBaseC;
    base.hex = oklchToHex(base.l, base.c, base.h);

    const N = palette.length;

    if (currentHarmony === 'analogous') {
      const step = 15;
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const offset = (idx - baseIndex) * step;
          p.h = (base.h + offset + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'monochromatic') {
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          p.h = base.h;
          const radialScale = 0.3 + (idx / Math.max(1, N - 1)) * 0.7;
          p.c = Math.min(0.37, Math.max(0.02, base.c * radialScale));
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'triadic') {
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const slot = idx % 3;
          p.h = (base.h + slot * 120 + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'complementary') {
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const isOpposite = idx % 2 === 1;
          p.h = isOpposite ? (base.h + 180 + 360) % 360 : base.h;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'split-complementary') {
      const offsets = [0, 150, 210, 150, 210];
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const off = offsets[idx % offsets.length];
          p.h = (base.h + off + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'tetradic') {
      const offsets = [0, 60, 180, 240, 60];
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const off = offsets[idx % offsets.length];
          p.h = (base.h + off + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'square') {
      const offsets = [0, 90, 180, 270, 90];
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const off = offsets[idx % offsets.length];
          p.h = (base.h + off + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    }
  }

  function setupWheelDragListeners() {
    let isDragging = false;
    let draggedIndex = 0;

    const handlePointerDown = (clientX: number, clientY: number) => {
      const rect = wheelInteractiveStage.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;

      let closestIdx = -1;
      let minDistance = 28;

      palette.forEach((item, idx) => {
        const pos = polarToStageCoords(item.h, item.c);
        const dist = Math.hypot(x - pos.x, y - pos.y);
        if (dist < minDistance) {
          minDistance = dist;
          closestIdx = idx;
        }
      });

      if (closestIdx !== -1) {
        draggedIndex = closestIdx;
      } else {
        draggedIndex = baseIndex;
      }

      isDragging = true;
      handlePointerMove(clientX, clientY);
    };

    const handlePointerMove = (clientX: number, clientY: number) => {
      if (!isDragging) return;

      const rect = wheelInteractiveStage.getBoundingClientRect();
      const x = Math.max(0, Math.min(300, clientX - rect.left));
      const y = Math.max(0, Math.min(300, clientY - rect.top));

      const { h, c } = stageCoordsToPolar(x, y);

      if (currentHarmony === 'custom') {
        const target = palette[draggedIndex];
        if (!target.isLocked) {
          target.h = h;
          target.c = c;
          target.hex = oklchToHex(target.l, target.c, target.h);
        }
      } else {
        applyHarmonyConstellation(h, c);
      }

      renderAll();
    };

    const handlePointerUp = () => {
      isDragging = false;
    };

    wheelInteractiveStage.addEventListener('mousedown', (e) => {
      e.preventDefault();
      handlePointerDown(e.clientX, e.clientY);

      const onMouseMove = (moveEvent: MouseEvent) => {
        handlePointerMove(moveEvent.clientX, moveEvent.clientY);
      };

      const onMouseUp = () => {
        handlePointerUp();
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
      };

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
    });

    wheelInteractiveStage.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        e.preventDefault();
        const touch = e.touches[0];
        handlePointerDown(touch.clientX, touch.clientY);
      }
    }, { passive: false });

    window.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        const touch = e.touches[0];
        handlePointerMove(touch.clientX, touch.clientY);
      }
    }, { passive: false });

    window.addEventListener('touchend', handlePointerUp);
  }

  function renderPaletteCards() {
    paletteSwatchesList.innerHTML = '';
    swatchesCountBadge.textContent = `${palette.length} Cores`;

    palette.forEach((item, idx) => {
      const card = document.createElement('div');
      card.className = `swatch-row-card ${item.isBase ? 'swatch-row-base' : ''}`;
      card.setAttribute('draggable', 'true');
      card.setAttribute('data-index', idx.toString());

      const inGamut = isInGamut({ l: item.l, c: item.c, h: item.h }, 'srgb');
      const cusp = findGamutCusp(item.h, 'srgb');

      let displayHex = item.hex;
      let isCvdActive = false;
      if (currentCvdMode !== 'normal') {
        const rgb = parseHex(item.hex) || { r: 0, g: 0, b: 0 };
        const simRgb = simulateCvd(rgb, currentCvdMode as CvdType, 1.0);
        displayHex = rgbToHex(simRgb);
        isCvdActive = true;
      }

      const whiteAudit = auditContrastHex('#FFFFFF', displayHex);
      const apcaScore = whiteAudit ? Math.abs(whiteAudit.apca.lc).toFixed(0) : '0';

      card.innerHTML = `
        <div class="drag-handle-grip" title="Arrastar para reordenar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="8" cy="6" r="2"></circle>
            <circle cx="16" cy="6" r="2"></circle>
            <circle cx="8" cy="12" r="2"></circle>
            <circle cx="16" cy="12" r="2"></circle>
            <circle cx="8" cy="18" r="2"></circle>
            <circle cx="16" cy="18" r="2"></circle>
          </svg>
        </div>

        <div class="swatch-left-group">
          <div class="swatch-square-thumb" style="background-color: ${displayHex}; ${isCvdActive ? `box-shadow: inset 0 0 0 2px ${item.hex};` : ''}" title="${isCvdActive ? `Original: ${item.hex} | Simulado: ${displayHex}` : item.hex}">
            <input type="color" value="${item.hex}" class="hidden-native-picker" data-action="pick-color" />
          </div>
          <div class="swatch-meta-text">
            <div class="swatch-hex-title">
              <span class="swatch-hex-label">${displayHex}</span>
              ${isCvdActive ? `<span class="swatch-orig-label">orig: ${item.hex}</span>` : ''}
              <span class="swatch-lc-pill">Lc ${apcaScore}</span>
              <span class="swatch-gamut-pill ${inGamut ? 'gamut-srgb' : 'gamut-p3'}" title="Cusp Max Chroma: ${cusp.max_chroma.toFixed(2)}">${inGamut ? 'sRGB' : 'P3 Wide'}</span>
            </div>
            <div class="swatch-tone-wrapper" data-stop-drag="true">
              <span class="tone-label">Tom: ${(item.l * 100).toFixed(0)}%</span>
              <input type="range" min="0.05" max="0.98" step="0.01" value="${item.l}" class="custom-range mini-tone-range" data-action="slider-tone" />
            </div>
          </div>
        </div>

        <div class="swatch-right-actions" data-stop-drag="true">
          <button class="swatch-action-link ${item.isBase ? 'action-is-base' : ''}" data-action="base">
            ${item.isBase ? '★ Cor Base' : 'Usar como base'}
          </button>
          <button class="swatch-action-link" data-action="copy">
            Copiar
          </button>
          <button class="swatch-icon-btn ${item.isLocked ? 'btn-is-locked' : ''}" data-action="lock" title="${item.isLocked ? 'Desbloquear tom' : 'Bloquear tom'}">
            ${item.isLocked ? '🔒' : '🔓'}
          </button>
          <button class="swatch-icon-btn delete-btn" data-action="delete" ${palette.length <= 2 ? 'disabled' : ''} title="Excluir cor">
            ✕
          </button>
        </div>
      `;

      card.addEventListener('dragstart', (e) => {
        draggedCardIndex = idx;
        card.classList.add('is-dragging-card');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', idx.toString());
        }
      });

      card.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) {
          e.dataTransfer.dropEffect = 'move';
        }
        card.classList.add('drag-over-target');
      });

      card.addEventListener('dragleave', () => {
        card.classList.remove('drag-over-target');
      });

      card.addEventListener('drop', (e) => {
        e.preventDefault();
        card.classList.remove('drag-over-target');
        if (draggedCardIndex !== null && draggedCardIndex !== idx) {
          const movedItem = palette.splice(draggedCardIndex, 1)[0];
          palette.splice(idx, 0, movedItem);
          baseIndex = palette.findIndex((p) => p.isBase);
          renderAll();
        }
        draggedCardIndex = null;
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('is-dragging-card');
        draggedCardIndex = null;
      });

      card.querySelectorAll('[data-stop-drag="true"]').forEach((el) => {
        el.addEventListener('mousedown', (e) => e.stopPropagation());
        el.addEventListener('touchstart', (e) => e.stopPropagation());
      });

      card.querySelector('[data-action="base"]')?.addEventListener('click', () => {
        palette.forEach((p) => (p.isBase = false));
        item.isBase = true;
        baseIndex = idx;
        renderAll();
      });

      card.querySelector('[data-action="lock"]')?.addEventListener('click', () => {
        item.isLocked = !item.isLocked;
        renderAll();
      });

      card.querySelector('[data-action="copy"]')?.addEventListener('click', () => {
        navigator.clipboard.writeText(displayHex);
        const btn = card.querySelector('[data-action="copy"]') as HTMLElement;
        const prev = btn.textContent;
        btn.textContent = 'Copiado!';
        setTimeout(() => {
          btn.textContent = prev;
        }, 1500);
      });

      card.querySelector('[data-action="delete"]')?.addEventListener('click', () => {
        if (palette.length > 2) {
          const wasBase = item.isBase;
          palette.splice(idx, 1);
          if (wasBase) {
            palette[0].isBase = true;
            baseIndex = 0;
          } else {
            baseIndex = palette.findIndex((p) => p.isBase);
          }
          renderAll();
        }
      });

      const toneRange = card.querySelector('[data-action="slider-tone"]') as HTMLInputElement;
      toneRange?.addEventListener('input', (e) => {
        item.l = parseFloat(toneRange.value);
        item.hex = oklchToHex(item.l, item.c, item.h);
        renderAll();
      });

      const nativePicker = card.querySelector('[data-action="pick-color"]') as HTMLInputElement;
      nativePicker?.addEventListener('input', () => {
        const ok = hexToOklch(nativePicker.value);
        if (ok) {
          item.hex = nativePicker.value.toUpperCase();
          item.l = ok.l;
          item.c = ok.c;
          item.h = ok.h;
          renderAll();
        }
      });

      paletteSwatchesList.appendChild(card);
    });
  }

  function updateBaseControls() {
    const base = palette[baseIndex] || palette[0];
    baseColorSquare.style.backgroundColor = base.hex;
    baseNativePicker.value = base.hex;
    baseHexInput.value = base.hex.replace(/^#/, '');

    const harmonyNameMap: Record<string, string> = {
      analogous: 'Análogo',
      monochromatic: 'Monocromático',
      triadic: 'Tríade',
      complementary: 'Complementar',
      'split-complementary': 'Split-Comp',
      tetradic: 'Tetradic',
      square: 'Quadrado',
      custom: 'Livre (Custom)',
    };
    currentHarmonyLabel.textContent = harmonyNameMap[currentHarmony] || currentHarmony;
  }

  function updateBottomPanels() {
    const base = palette[baseIndex] || palette[0];
    let baseHex = base.hex;

    if (currentCvdMode !== 'normal') {
      const rgb = parseHex(base.hex) || { r: 0, g: 0, b: 0 };
      const sim = simulateCvd(rgb, currentCvdMode as CvdType, 1.0);
      baseHex = rgbToHex(sim);
    }

    const onWhite = auditContrastHex(baseHex, '#FFFFFF');
    const onBlack = auditContrastHex(baseHex, '#0A0D14');

    if (onWhite) {
      metricWcagWhite.textContent = `${onWhite.wcag.ratio.toFixed(2)}:1`;
      metricApcaWhite.textContent = `${onWhite.apca.lc > 0 ? '+' : ''}${onWhite.apca.lc.toFixed(1)}`;
      badgesWhite.innerHTML = `
        <span class="badge ${onWhite.wcag.normal_aa ? 'badge-pass' : 'badge-fail'}">AA: ${onWhite.wcag.normal_aa ? 'PASS' : 'FAIL'}</span>
        <span class="badge ${onWhite.apca.body_text ? 'badge-pass' : 'badge-fail'}">APCA: ${onWhite.apca.body_text ? 'PASS' : 'FAIL'}</span>
      `;
    }

    if (onBlack) {
      metricWcagBlack.textContent = `${onBlack.wcag.ratio.toFixed(2)}:1`;
      metricApcaBlack.textContent = `${onBlack.apca.lc > 0 ? '+' : ''}${onBlack.apca.lc.toFixed(1)}`;
      badgesBlack.innerHTML = `
        <span class="badge ${onBlack.wcag.normal_aa ? 'badge-pass' : 'badge-fail'}">AA: ${onBlack.wcag.normal_aa ? 'PASS' : 'FAIL'}</span>
        <span class="badge ${onBlack.apca.body_text ? 'badge-pass' : 'badge-fail'}">APCA: ${onBlack.apca.body_text ? 'PASS' : 'FAIL'}</span>
      `;
    }

    const whiteAudit = auditContrastHex('#FFFFFF', baseHex);
    const blackAudit = auditContrastHex('#000000', baseHex);
    const whiteScore = whiteAudit ? Math.abs(whiteAudit.apca.lc) : 0;
    const blackScore = blackAudit ? Math.abs(blackAudit.apca.lc) : 0;

    if (whiteScore >= blackScore) {
      inkNameText.textContent = `Tinta Branca (#FFFFFF) — Lc ${whiteScore.toFixed(1)}`;
      inkDot.style.backgroundColor = '#FFFFFF';
    } else {
      inkNameText.textContent = `Tinta Escura (#0A0D14) — Lc ${blackScore.toFixed(1)}`;
      inkDot.style.backgroundColor = '#0A0D14';
    }

    const tokens = generateDesignTokens(baseHex);
    if (tokens) {
      previewBtnBrand.style.backgroundColor = tokens.light['--brand'];
      previewBtnBrand.style.color = '#FFFFFF';
      previewBtnSubtle.style.backgroundColor = tokens.light['--surface-2'];
      previewBtnSubtle.style.color = tokens.light['--ink'];
      previewBtnSubtle.style.border = `1px solid ${tokens.light['--line']}`;
      previewCardBox.style.backgroundColor = tokens.light['--surface'];
      previewCardBox.style.border = `1px solid ${tokens.light['--line']}`;
      previewCardBadge.style.backgroundColor = tokens.light['--brand'];
      previewCardBadge.style.color = '#FFFFFF';

      const formatted = exportTokens(tokens, currentFormat as any);
      tokensCodeOutput.textContent = formatted;
    }
  }

  function renderCvdMatrix() {
    if (!cvdMatrixGrid) return;
    cvdMatrixGrid.innerHTML = '';

    const modes: { key: string; label: string; sub: string }[] = [
      { key: 'normal', label: 'Visão Padrão', sub: 'Tricromata' },
      { key: 'protanopia', label: 'Protanopia', sub: 'Sem Cones L (Vermelho)' },
      { key: 'deuteranopia', label: 'Deuteranopia', sub: 'Sem Cones M (Verde)' },
      { key: 'tritanopia', label: 'Tritanopia', sub: 'Sem Cones S (Azul)' },
      { key: 'achromatopsia', label: 'Acromatopsia', sub: 'Monocromático (Hastes)' },
    ];

    modes.forEach((mode) => {
      const col = document.createElement('div');
      col.className = `cvd-matrix-col ${currentCvdMode === mode.key ? 'cvd-matrix-col-active' : ''}`;

      let swatchesHtml = '';
      palette.forEach((p) => {
        let hex = p.hex;
        if (mode.key !== 'normal') {
          const rgb = parseHex(p.hex) || { r: 0, g: 0, b: 0 };
          const sim = simulateCvd(rgb, mode.key as CvdType, 1.0);
          hex = rgbToHex(sim);
        }

        const onWhite = auditContrastHex(hex, '#FFFFFF');
        const lc = onWhite ? Math.abs(onWhite.apca.lc).toFixed(0) : '0';
        const isAA = onWhite?.wcag.normal_aa;

        swatchesHtml += `
          <div class="cvd-swatch-item">
            <div class="cvd-swatch-chip" style="background-color: ${hex}"></div>
            <div class="cvd-swatch-info">
              <span class="cvd-swatch-hex">${hex}</span>
              <span class="badge ${isAA ? 'badge-pass' : 'badge-fail'}">AA / Lc ${lc}</span>
            </div>
          </div>
        `;
      });

      col.innerHTML = `
        <div class="cvd-col-header">
          <div class="cvd-col-title">${mode.label}</div>
          <div class="cvd-col-sub">${mode.sub}</div>
        </div>
        <div class="cvd-col-items">
          ${swatchesHtml}
        </div>
      `;

      cvdMatrixGrid.appendChild(col);
    });
  }

  function renderAll() {
    drawWheelCanvas();
    renderWheelPins();
    renderPaletteCards();
    renderCvdMatrix();
    updateBaseControls();
    updateBottomPanels();
  }

  cvdModeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      cvdModeButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentCvdMode = (btn.getAttribute('data-cvd') as any) || 'normal';
      const labelMap: Record<string, string> = {
        normal: 'Visão Padrão',
        protanopia: 'Protanopia Ativa (Sem L)',
        deuteranopia: 'Deuteranopia Ativa (Sem M)',
        tritanopia: 'Tritanopia Ativa (Sem S)',
        achromatopsia: 'Acromatopsia Ativa (Mono)',
      };
      if (cvdActiveLabel) {
        cvdActiveLabel.textContent = labelMap[currentCvdMode] || currentCvdMode;
      }
      renderAll();
    });
  });

  baseHexInput.addEventListener('input', () => {
    const val = baseHexInput.value.trim();
    if (/^[0-9A-Fa-f]{6}$/.test(val)) {
      const fullHex = `#${val}`.toUpperCase();
      const ok = hexToOklch(fullHex);
      if (ok) {
        if (currentHarmony === 'custom') {
          const base = palette[baseIndex] || palette[0];
          base.hex = fullHex;
          base.l = ok.l;
          base.c = ok.c;
          base.h = ok.h;
        } else {
          applyHarmonyConstellation(ok.h, ok.c);
        }
        renderAll();
      }
    }
  });

  baseNativePicker.addEventListener('input', () => {
    const ok = hexToOklch(baseNativePicker.value);
    if (ok) {
      if (currentHarmony === 'custom') {
        const base = palette[baseIndex] || palette[0];
        base.hex = baseNativePicker.value.toUpperCase();
        base.l = ok.l;
        base.c = ok.c;
        base.h = ok.h;
      } else {
        applyHarmonyConstellation(ok.h, ok.c);
      }
      renderAll();
    }
  });

  eyedropperBtn.addEventListener('click', async () => {
    if ('EyeDropper' in window) {
      try {
        const eyeDropper = new (window as any).EyeDropper();
        const result = await eyeDropper.open();
        if (result?.sRGBHex) {
          const ok = hexToOklch(result.sRGBHex);
          if (ok) {
            if (currentHarmony === 'custom') {
              const base = palette[baseIndex] || palette[0];
              base.hex = result.sRGBHex.toUpperCase();
              base.l = ok.l;
              base.c = ok.c;
              base.h = ok.h;
            } else {
              applyHarmonyConstellation(ok.h, ok.c);
            }
            renderAll();
          }
        }
      } catch {
        // User cancelled
      }
    } else {
      baseNativePicker.click();
    }
  });

  randomizeBtn.addEventListener('click', () => {
    const randomH = Math.floor(Math.random() * 360);
    const randomC = 0.12 + Math.random() * 0.14;
    applyHarmonyConstellation(randomH, randomC);
    renderAll();
  });

  addSwatchBtn.addEventListener('click', () => {
    if (palette.length < 10) {
      const base = palette[baseIndex] || palette[0];
      const newH = (base.h + palette.length * 35 + 360) % 360;
      const hex = oklchToHex(base.l, base.c, newH);
      palette.push({
        id: Math.random().toString(36).substring(2, 9),
        hex,
        l: base.l,
        c: base.c,
        h: newH,
        isBase: false,
        isLocked: false,
      });
      renderAll();
    }
  });

  harmonyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      harmonyButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentHarmony = btn.getAttribute('data-mode') || 'analogous';
      if (currentHarmony !== 'custom') {
        const base = palette[baseIndex] || palette[0];
        applyHarmonyConstellation(base.h, base.c);
      }
      renderAll();
    });
  });

  tokenTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tokenTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      currentFormat = tab.getAttribute('data-format') || 'css';
      updateBottomPanels();
    });
  });

  copyTokensBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(tokensCodeOutput.textContent || '');
    const prev = copyTokensBtn.innerHTML;
    copyTokensBtn.innerHTML = `<span>Copiado!</span>`;
    setTimeout(() => {
      copyTokensBtn.innerHTML = prev;
    }, 2000);
  });

  downloadTokensBtn.addEventListener('click', () => {
    const text = tokensCodeOutput.textContent || '';
    const extMap: Record<string, string> = {
      css: 'css',
      'tailwind-v4': 'css',
      'tailwind-v3': 'js',
      'figma-tokens': 'json',
      'style-dictionary': 'json',
      swift: 'swift',
      'android-xml': 'xml',
    };
    const ext = extMap[currentFormat] || 'txt';
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `colorust-tokens.${ext}`;
    a.click();
    URL.revokeObjectURL(url);
  });

  imageFileInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const ctx = extractCanvas.getContext('2d');
        if (!ctx) return;
        extractCanvas.width = 120;
        extractCanvas.height = 120;
        ctx.drawImage(img, 0, 0, 120, 120);
        const imgData = ctx.getImageData(0, 0, 120, 120).data;

        const quantized = quantizeImage(imgData, 5, 15);
        if (quantized && quantized.length > 0) {
          palette = quantized.map((q, idx) => ({
            id: Math.random().toString(36).substring(2, 9),
            hex: rgbToHex(q.rgb),
            l: q.oklch.l,
            c: q.oklch.c,
            h: q.oklch.h,
            isBase: idx === 0,
            isLocked: false,
          }));
          baseIndex = 0;
          currentHarmony = 'custom';
          harmonyButtons.forEach((b) => {
            if (b.getAttribute('data-mode') === 'custom') {
              b.classList.add('active');
            } else {
              b.classList.remove('active');
            }
          });
          renderAll();
        }
      };
      img.src = event.target?.result as string;
    };
    reader.readAsDataURL(file);
  });

  setupWheelDragListeners();
  initDefaultPalette();
</script>

<style is:global>
  .studio-wrapper {
    display: flex;
    flex-direction: column;
