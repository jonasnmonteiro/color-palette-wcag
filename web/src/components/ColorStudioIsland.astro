  function getEffectiveHex(hex: string): string {
    if (currentCvdMode === 'normal') return hex;
    const rgb = parseHex(hex) || { r: 0, g: 0, b: 0 };
    const sim = simulateCvd(rgb, currentCvdMode as CvdType, 1.0);
    return rgbToHex(sim);
  }

