  function syncHashUrl() {
    try {
      const hexes = palette.map((p) => p.hex.replace('#', '')).join(',');
      const hash = `harmony=${currentHarmony}&cvd=${currentCvdMode}&pins=${hexes}`;
      history.replaceState(null, '', `#${hash}`);
    } catch {
      // Ignored
    }
  }

  function parseHashUrl(): boolean {
    try {
      const hash = window.location.hash.replace(/^#/, '');
      if (!hash) return false;

      const params = new URLSearchParams(hash);
      const pinsStr = params.get('pins');
      const harmonyStr = params.get('harmony');
      const cvdStr = params.get('cvd');

      if (cvdStr && ['normal', 'protanopia', 'deuteranopia', 'tritanopia', 'achromatopsia'].includes(cvdStr)) {
        currentCvdMode = cvdStr as any;
        cvdModeButtons.forEach((btn) => {
          if (btn.getAttribute('data-cvd') === currentCvdMode) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }

      if (harmonyStr) {
        currentHarmony = harmonyStr;
        harmonyButtons.forEach((b) => {
          if (b.getAttribute('data-mode') === currentHarmony) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
      }

      if (pinsStr) {
        const hexList = pinsStr.split(',').map((h) => `#${h.trim().toUpperCase()}`);
        if (hexList.length >= 2) {
          palette = hexList.map((hex, idx) => {
            const ok = hexToOklch(hex) || { l: 0.6, c: 0.15, h: 200 };
            return {
              id: `p${idx}-${Math.random().toString(36).substring(2, 6)}`,
              hex,
              l: ok.l,
              c: ok.c,
              h: ok.h,
              isBase: idx === 0,
              isLocked: false,
            };
          });
          baseIndex = 0;
          return true;
        }
      }
    } catch {
      // Fallback
    }
    return false;
  }

