    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
  }

  .palette-swatches-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Dashed Add Swatch Card */
  .add-swatch-dashed-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    margin-top: 10px;
    border: 2px dashed var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface-elevated);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .add-swatch-dashed-card:hover {
    border-color: var(--brand-primary);
    background: color-mix(in srgb, var(--brand-primary) 10%, transparent);
    color: var(--brand-light, #2563EB);
  }

  .add-swatch-dashed-card:active {
    transform: scale(0.99);
  }

  /* ADOBE COLOR STYLE SOLID SWATCH CARDS */
  .swatch-solid-card {
    border-radius: var(--radius-md);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.15s ease;
    position: relative;
    border: 1px solid color-mix(in srgb, var(--text-on-accent, #FFFFFF) 15%, transparent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--shadow-base, #000000) 25%, transparent);
    user-select: none;
  }

  .swatch-solid-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--shadow-base, #000000) 35%, transparent);
  }

  .swatch-solid-card.swatch-solid-base {
    border: 2px solid var(--text-on-accent, #FFFFFF);
    box-shadow: 0 0 0 2px var(--brand-primary), 0 6px 20px color-mix(in srgb, var(--shadow-base, #000000) 40%, transparent);
  }

  .swatch-solid-card.is-dragging-card {
    opacity: 0.4;
    border-style: dashed;
  }

  .swatch-solid-card.drag-over-target {
    transform: scale(1.02);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--shadow-base, #000000) 40%, transparent);
  }

  /* Light Ink Theme (Dark / Saturated Background) */
  .swatch-solid-card.theme-light-ink {
    color: var(--swatch-ink-light, #FFFFFF);
  }

  .swatch-solid-card.theme-light-ink .drag-handle-grip {
    color: color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 75%, transparent);
  }

  .swatch-solid-card.theme-light-ink .swatch-solid-hex {
    color: var(--swatch-ink-light, #FFFFFF);
    text-shadow: 0 1px 3px color-mix(in srgb, var(--shadow-base, #000000) 40%, transparent);
  }

  .swatch-solid-card.theme-light-ink .swatch-solid-pill {
    background: color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 28%, transparent);
    color: var(--swatch-ink-light, #FFFFFF);
  }

  .swatch-solid-card.theme-light-ink .swatch-action-pill,
  .swatch-solid-card.theme-light-ink .swatch-icon-btn {
    background: color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 26%, transparent);
    color: var(--swatch-ink-light, #FFFFFF);
  }

  .swatch-solid-card.theme-light-ink .swatch-action-pill:hover,
  .swatch-solid-card.theme-light-ink .swatch-icon-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 28%, transparent);
  }

  .swatch-solid-card.theme-light-ink .swatch-action-pill.is-base-active {
    background: var(--swatch-ink-light, #FFFFFF);
    color: var(--swatch-ink-dark, #0F172A) !important;
    border-color: var(--swatch-ink-light, #FFFFFF);
    font-weight: 700;
  }

  .swatch-solid-card.theme-light-ink .tone-inline-label {
    color: color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 85%, transparent);
  }

  .swatch-solid-card.theme-light-ink .swatch-tone-slider {
    background: color-mix(in srgb, var(--swatch-ink-light, #FFFFFF) 25%, transparent);
  }

  /* Dark Ink Theme (Bright / Pastel Background) */
  .swatch-solid-card.theme-dark-ink {
    color: var(--swatch-ink-dark, #0F172A);
  }

  .swatch-solid-card.theme-dark-ink .drag-handle-grip {
    color: color-mix(in srgb, var(--shadow-base, #000000) 65%, transparent);
  }

  .swatch-solid-card.theme-dark-ink .swatch-solid-hex {
    color: var(--swatch-ink-dark, #0F172A);
  }

  .swatch-solid-card.theme-dark-ink .swatch-solid-pill {
    background: color-mix(in srgb, var(--shadow-base, #000000) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--shadow-base, #000000) 22%, transparent);
    color: var(--swatch-ink-dark, #0F172A);
  }

  .swatch-solid-card.theme-dark-ink .swatch-action-pill,
  .swatch-solid-card.theme-dark-ink .swatch-icon-btn {
    background: color-mix(in srgb, var(--shadow-base, #000000) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--shadow-base, #000000) 22%, transparent);
    color: var(--swatch-ink-dark, #0F172A);
  }

  .swatch-solid-card.theme-dark-ink .swatch-action-pill:hover,
  .swatch-solid-card.theme-dark-ink .swatch-icon-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--shadow-base, #000000) 22%, transparent);
  }

  .swatch-solid-card.theme-dark-ink .swatch-action-pill.is-base-active {
    background: var(--swatch-ink-dark, #0F172A);
    color: var(--swatch-ink-light, #FFFFFF) !important;
    border-color: var(--swatch-ink-dark, #0F172A);
    font-weight: 700;
  }

  .swatch-solid-card.theme-dark-ink .tone-inline-label {
    color: color-mix(in srgb, var(--shadow-base, #000000) 75%, transparent);
  }

  .swatch-solid-card.theme-dark-ink .swatch-tone-slider {
    background: color-mix(in srgb, var(--shadow-base, #000000) 20%, transparent);
  }

  .swatch-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .swatch-card-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .swatch-hex-picker-wrap {
    position: relative;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }

  .swatch-solid-hex {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--text-on-accent, #FFFFFF) 10%, transparent);
  }

  .swatch-solid-pill {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
  }

  .swatch-card-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .swatch-action-pill {
    font-size: 11px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .swatch-icon-btn {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .swatch-icon-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .swatch-tone-inline-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .tone-inline-label {
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
    white-space: nowrap;
    min-width: 65px;
  }

  .swatch-tone-slider {
    flex: 1;
    height: 6px;
    border-radius: var(--radius-full);
  }

  .drag-handle-grip {
    cursor: grab;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    user-select: none;
  }

  .drag-handle-grip:active {
    cursor: grabbing;
  }

  .palette-footer-row {
    margin-top: 8px;
  }

  .export-anchor-btn {
    width: 100%;
    text-align: center;
  }

  /* CVD Selector Bar */
  .cvd-selector-container {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cvd-header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cvd-active-status {
    font-size: 11px;
    font-weight: 700;
    color: var(--brand-light, #2563EB);
    background: color-mix(in srgb, var(--brand-primary) 15%, transparent);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
  }

  .cvd-modes-buttons {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
  }

  .cvd-mode-btn {
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .cvd-mode-btn:hover {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--brand-primary) 8%, var(--bg-surface));
  }

  .cvd-mode-btn.active {
    background: color-mix(in srgb, var(--brand-primary) 15%, transparent);
    border-color: var(--brand-primary);
    color: var(--brand-light, #2563EB);
    font-weight: 700;
  }

  .cvd-sub-badge {
    font-size: 9px;
    opacity: 0.7;
  }

  .swatch-orig-label {
    font-size: 10px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .swatch-gamut-pill {
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: var(--radius-full);
  }

  .gamut-srgb {
    background: color-mix(in srgb, var(--color-success) 15%, transparent);
    color: var(--color-success);
    border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent);
  }

  .gamut-p3 {
    background: color-mix(in srgb, var(--gamut-wide) 15%, transparent);
    color: var(--gamut-wide);
    border: 1px solid color-mix(in srgb, var(--gamut-wide) 30%, transparent);
  }

  /* CVD Multimodal Panel */
  .cvd-matrix-panel {
    padding: 24px;
  }

  .cvd-matrix-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-top: 16px;
  }

  .cvd-matrix-col {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.2s ease;
  }

  .cvd-matrix-col-active {
    border-color: color-mix(in srgb, var(--brand-primary) 60%, transparent);
    background: color-mix(in srgb, var(--brand-primary) 8%, var(--bg-surface-elevated));
  }

  .cvd-col-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 8px;
  }

  .cvd-col-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cvd-col-sub {
    font-size: 10px;
    color: var(--text-muted);
  }

  .cvd-col-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cvd-swatch-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px;
    border-radius: var(--radius-sm);
  }

  .cvd-swatch-chip {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .cvd-swatch-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .cvd-swatch-hex {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }

  /* UI SHOWCASE PANEL & MOCKUP CANVAS */
  .ui-showcase-panel {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ui-mockup-controls {
    display: flex;
    align-items: center;
  }

  .theme-toggle-group {
    display: flex;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px;
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .theme-toggle-btn.active {
    background: color-mix(in srgb, var(--brand-primary) 18%, transparent);
    color: var(--brand-light, #2563EB);
    font-weight: 700;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--shadow-base, #000000) 10%, transparent);
  }

  .mockup-canvas-wrapper {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: all 0.3s ease;
  }

  .mockup-app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-radius: var(--radius-md);
    border: 1px solid;
  }

  .mockup-brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mockup-logo-mark {
    width: 14px;
    height: 14px;
    border-radius: 4px;
  }

  .mockup-brand-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .mockup-nav-links {
    display: flex;
    gap: 18px;
  }

  .mockup-nav-item {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.7;
    cursor: pointer;
    padding-bottom: 2px;
  }

  .mockup-nav-item.active {
    opacity: 1;
    border-bottom: 2px solid;
  }

  .mockup-user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
  }

  .mockup-kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .mockup-kpi-card {
    padding: 16px;
    border-radius: var(--radius-md);
    border: 1px solid;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kpi-label {
    font-size: 11px;
    font-weight: 600;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .kpi-value-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .kpi-num {
    font-size: 22px;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .kpi-growth-badge, .kpi-status-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .kpi-bar-track {
    height: 6px;
    background: color-mix(in srgb, var(--text-primary) 12%, transparent);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .kpi-bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  .mockup-content-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 16px;
  }

  .mockup-feature-box, .mockup-form-box {
    padding: 20px;
    border-radius: var(--radius-md);
    border: 1px solid;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .feature-tag-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mockup-pill-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    letter-spacing: 0.06em;
  }

  .feature-stars {
    font-size: 12px;
    color: var(--color-warning);
    font-weight: 600;
  }

  .feature-card-heading {
    font-size: 17px;
    font-weight: 700;
  }

  .feature-card-summary {
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.8;
  }

  .feature-action-row {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }

  .mockup-btn-brand {
    padding: 9px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .mockup-btn-brand:hover {
    transform: translateY(-1px);
  }

  .mockup-btn-outline {
    padding: 9px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .form-row-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field-label {
    font-size: 11px;
    font-weight: 700;
    opacity: 0.7;
    text-transform: uppercase;
  }

  .form-input-wrapper {
    display: flex;
    gap: 8px;
  }

  .mockup-text-input {
    flex: 1;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    border: 1px solid;
    font-family: var(--font-mono);
    font-size: 12px;
    outline: none;
  }

  .mockup-input-btn {
    padding: 8px 14px;
    border-radius: var(--radius-md);
    border: none;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .form-switches-row {
    display: flex;
    gap: 8px;
  }

  .mockup-badge-pill {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .form-progress-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .progress-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    opacity: 0.7;
    font-weight: 600;
  }

  .mockup-gradient-bar {
    height: 10px;
    border-radius: var(--radius-full);
  }

  /* Bottom Section: Contrast Gates & Tokens */
  .studio-bottom-grid {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 24px;
  }

  .studio-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .contrast-gates-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .contrast-gate-box {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .gate-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .gate-metrics {
    display: flex;
    justify-content: space-between;
  }

  .gate-metric {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-size: 20px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .metric-label {
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .gate-badges {
    display: flex;
    gap: 6px;
  }

  .ink-recommendation-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 16px;
  }

  .ink-meta {
    display: flex;
    flex-direction: column;
  }

  .ink-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ink-reason {
    font-size: 11px;
    color: var(--text-muted);
  }

  .ink-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
