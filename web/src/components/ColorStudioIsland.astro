---
---

<div class="studio-wrapper" id="aura-studio-app">
  <!-- Top Section: Chromatic Wheel & Harmonies -->
  <div class="glass-panel wheel-harmony-panel">
    <div class="panel-header-row">
      <div>
        <h2 class="section-title">Color Harmony & Chromatic Wheel</h2>
        <p class="section-subtitle">Interactive multi-handle color wheel powered by OKLCH perceptual color space</p>
      </div>
      <div class="top-action-bar">
        <button class="btn-secondary" id="randomize-palette-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 3 21 3 21 8"></polyline>
            <line x1="4" y1="20" x2="21" y2="3"></line>
            <polyline points="21 16 21 21 16 21"></polyline>
            <line x1="15" y1="15" x2="21" y2="21"></line>
            <line x1="4" y1="4" x2="9" y2="9"></line>
          </svg>
          Shuffle Palette
        </button>
        <button class="btn-primary" id="add-swatch-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Color
        </button>
      </div>
    </div>

    <div class="wheel-section-grid">
      <!-- Left: Harmony Rules & Global Sliders -->
      <div class="harmony-sidebar">
        <label class="field-label">Harmony Rule</label>
        <div class="harmony-selector-grid" id="harmony-buttons">
          <button class="harmony-btn active" data-mode="analogous">
            <span class="harmony-icon">◐</span>
            Analogous
          </button>
          <button class="harmony-btn" data-mode="monochromatic">
            <span class="harmony-icon">◒</span>
            Monochromatic
          </button>
          <button class="harmony-btn" data-mode="triadic">
            <span class="harmony-icon">▲</span>
            Triad
          </button>
          <button class="harmony-btn" data-mode="complementary">
            <span class="harmony-icon">◓</span>
            Complementary
          </button>
          <button class="harmony-btn" data-mode="split-complementary">
            <span class="harmony-icon">⋔</span>
            Split Complementary
          </button>
          <button class="harmony-btn" data-mode="tetradic">
            <span class="harmony-icon">◆</span>
            Tetradic (Double Split)
          </button>
          <button class="harmony-btn" data-mode="square">
            <span class="harmony-icon">■</span>
            Square
          </button>
          <button class="harmony-btn" data-mode="custom">
            <span class="harmony-icon">✦</span>
            Custom (Freeform)
          </button>
        </div>

        <div class="base-sliders-card">
          <div class="base-badge-row">
            <span class="field-label">Active Base Color</span>
            <span class="badge badge-pass" id="base-color-badge">#3B82F6</span>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <span class="slider-name">Lightness (L)</span>
              <span class="slider-value" id="val-l">0.62</span>
            </div>
            <input type="range" id="slider-l" min="0.05" max="0.98" step="0.01" value="0.62" class="custom-range" />
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <span class="slider-name">Chroma (C)</span>
              <span class="slider-value" id="val-c">0.19</span>
            </div>
            <input type="range" id="slider-c" min="0" max="0.37" step="0.005" value="0.19" class="custom-range" />
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <span class="slider-name">Hue Angle (H)</span>
              <span class="slider-value" id="val-h">254°</span>
            </div>
            <input type="range" id="slider-h" min="0" max="360" step="1" value="254" class="custom-range" />
          </div>
        </div>

        <!-- Image Extractor -->
        <label class="image-dropzone" for="image-file-input" id="image-dropzone">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>Extract from Image</span>
          <input type="file" id="image-file-input" accept="image/*" class="file-hidden-input" />
        </label>
        <canvas id="extract-canvas" style="display:none;"></canvas>
      </div>

      <!-- Center / Right: Interactive Color Wheel -->
      <div class="wheel-stage-container">
        <div class="wheel-wrapper" id="wheel-wrapper">
          <canvas id="wheel-canvas" width="360" height="360" class="wheel-canvas"></canvas>
          <svg id="wheel-svg-lines" class="wheel-lines-svg" width="360" height="360"></svg>
          <div id="wheel-pins-layer" class="wheel-pins-layer"></div>
        </div>
        <div class="wheel-legend">
          <span class="legend-item"><span class="legend-dot base-dot"></span> Base Anchor (Rotating drives harmony)</span>
          <span class="legend-item"><span class="legend-dot harmonic-dot"></span> Harmonic Nodes</span>
          <span class="legend-item"><span class="legend-dot locked-dot"></span> Locked Nodes</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Middle Section: Rich Palette Cards Bar -->
  <div class="glass-panel palette-cards-panel">
    <div class="panel-header-row">
      <div>
        <h2 class="section-title">Color Palette Manager</h2>
        <p class="section-subtitle">Lock swatches, fine-tune individual tones, reorder, delete, and copy hex codes</p>
      </div>
      <div class="palette-counter" id="palette-count-text">5 Swatches</div>
    </div>

    <div class="palette-cards-row" id="palette-cards-row"></div>
  </div>

  <!-- Bottom Section: Auditor, Preview, and Token Exporter Grid -->
  <div class="studio-bottom-grid">
    <!-- Left Column: Contrast Auditor Gates & Dual Inks -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Accessibility & Contrast Gates</h2>
        <span class="badge badge-pass" id="global-wcag-badge">WCAG 2.1 AA</span>
      </div>

      <div class="contrast-gates-grid">
        <div class="contrast-gate-box" id="gate-on-white">
          <div class="gate-title">Contrast on White (#FFFFFF)</div>
          <div class="gate-metrics">
            <div class="gate-metric">
              <span class="metric-val" id="metric-wcag-white">4.5:1</span>
              <span class="metric-label">WCAG 2.1</span>
            </div>
            <div class="gate-metric">
              <span class="metric-val" id="metric-apca-white">-78.2</span>
              <span class="metric-label">APCA Lc</span>
            </div>
          </div>
          <div class="gate-badges" id="badges-white"></div>
        </div>

        <div class="contrast-gate-box" id="gate-on-black">
          <div class="gate-title">Contrast on Dark (#0A0D14)</div>
          <div class="gate-metrics">
            <div class="gate-metric">
              <span class="metric-val" id="metric-wcag-black">8.4:1</span>
              <span class="metric-label">WCAG 2.1</span>
            </div>
            <div class="gate-metric">
              <span class="metric-val" id="metric-apca-black">+84.5</span>
              <span class="metric-label">APCA Lc</span>
            </div>
          </div>
          <div class="gate-badges" id="badges-black"></div>
        </div>
      </div>

      <div class="ink-recommendation-box">
        <div class="ink-meta">
          <span class="ink-label">Optimal Text Ink for Base Color</span>
          <span class="ink-reason" id="ink-reason-text">Highest perceptual readability score</span>
        </div>
        <div class="ink-pill" id="recommended-ink-pill">
          <span class="ink-pill-dot" id="ink-dot"></span>
          <span id="ink-name-text">White Ink (#FFFFFF)</span>
        </div>
      </div>
    </div>

    <!-- Middle Column: Live Component Preview -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Live Semantic UI Preview</h2>
        <span class="badge badge-neutral">Design System</span>
      </div>

      <div class="preview-surface" id="preview-surface">
        <div class="preview-row">
          <button class="preview-btn-primary" id="preview-btn-brand">Primary Button</button>
          <button class="preview-btn-secondary" id="preview-btn-subtle">Secondary Action</button>
        </div>

        <div class="preview-card" id="preview-card-box">
          <div class="preview-card-header">
            <span class="preview-card-badge" id="preview-card-badge">PRO THEME</span>
            <span class="preview-card-title">Live Token Canvas</span>
          </div>
          <p class="preview-card-desc">Theme tokens synthesized dynamically using uniform OKLCH perceptual lightness.</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Token Exporter -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Token Exporter</h2>
        <button class="btn-secondary copy-btn" id="copy-tokens-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copy Code
        </button>
      </div>

      <div class="token-tabs" id="token-format-tabs">
        <button class="token-tab active" data-format="css">CSS</button>
        <button class="token-tab" data-format="tailwind-v4">Tailwind v4</button>
        <button class="token-tab" data-format="tailwind-v3">Tailwind v3</button>
        <button class="token-tab" data-format="figma-tokens">Figma DTCG</button>
        <button class="token-tab" data-format="style-dictionary">Style Dict</button>
        <button class="token-tab" data-format="swift">SwiftUI</button>
        <button class="token-tab" data-format="android-xml">Android XML</button>
      </div>

      <div class="code-viewer-container">
        <pre class="code-block"><code id="tokens-code-output">Loading tokens...</code></pre>
      </div>

      <div class="download-footer">
        <button class="btn-primary download-btn" id="download-tokens-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download Tokens
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    auditContrastHex,
    exportTokens,
    generateDesignTokens,
    generateHarmony,
    hexToOklch,
    oklchToHex,
  } from '../../../wasm/src/index';

  interface PaletteItem {
    id: string;
    hex: string;
    l: number;
    c: number;
    h: number;
    isBase: boolean;
    isLocked: boolean;
  }

  let palette: PaletteItem[] = [];
  let currentHarmony = 'analogous';
  let currentFormat = 'css';
  let baseIndex = 0;

  const wheelCanvas = document.getElementById('wheel-canvas') as HTMLCanvasElement;
  const wheelSvgLines = document.getElementById('wheel-svg-lines') as unknown as SVGSVGElement;
  const wheelPinsLayer = document.getElementById('wheel-pins-layer') as HTMLDivElement;
  const wheelWrapper = document.getElementById('wheel-wrapper') as HTMLDivElement;

  const sliderL = document.getElementById('slider-l') as HTMLInputElement;
  const sliderC = document.getElementById('slider-c') as HTMLInputElement;
  const sliderH = document.getElementById('slider-h') as HTMLInputElement;
  const valL = document.getElementById('val-l') as HTMLElement;
  const valC = document.getElementById('val-c') as HTMLElement;
  const valH = document.getElementById('val-h') as HTMLElement;
  const baseColorBadge = document.getElementById('base-color-badge') as HTMLElement;

  const harmonyButtons = document.querySelectorAll('.harmony-btn');
  const paletteCardsRow = document.getElementById('palette-cards-row') as HTMLDivElement;
  const paletteCountText = document.getElementById('palette-count-text') as HTMLElement;
  const addSwatchBtn = document.getElementById('add-swatch-btn') as HTMLButtonElement;
  const randomizeBtn = document.getElementById('randomize-palette-btn') as HTMLButtonElement;

  const metricWcagWhite = document.getElementById('metric-wcag-white') as HTMLElement;
  const metricApcaWhite = document.getElementById('metric-apca-white') as HTMLElement;
  const badgesWhite = document.getElementById('badges-white') as HTMLElement;
  const metricWcagBlack = document.getElementById('metric-wcag-black') as HTMLElement;
  const metricApcaBlack = document.getElementById('metric-apca-black') as HTMLElement;
  const badgesBlack = document.getElementById('badges-black') as HTMLElement;

  const inkNameText = document.getElementById('ink-name-text') as HTMLElement;
  const inkDot = document.getElementById('ink-dot') as HTMLElement;

  const previewSurface = document.getElementById('preview-surface') as HTMLElement;
  const previewBtnBrand = document.getElementById('preview-btn-brand') as HTMLElement;
  const previewBtnSubtle = document.getElementById('preview-btn-subtle') as HTMLElement;
  const previewCardBox = document.getElementById('preview-card-box') as HTMLElement;
  const previewCardBadge = document.getElementById('preview-card-badge') as HTMLElement;

  const tokensCodeOutput = document.getElementById('tokens-code-output') as HTMLElement;
  const copyTokensBtn = document.getElementById('copy-tokens-btn') as HTMLButtonElement;
  const downloadTokensBtn = document.getElementById('download-tokens-btn') as HTMLButtonElement;
  const tokenTabs = document.querySelectorAll('.token-tab');

  const imageFileInput = document.getElementById('image-file-input') as HTMLInputElement;
  const extractCanvas = document.getElementById('extract-canvas') as HTMLCanvasElement;

  function initDefaultPalette() {
    const baseHex = '#3B82F6';
    const swatches = generateHarmony(baseHex, currentHarmony as any, 5);
    palette = swatches.map((s, idx) => ({
      id: Math.random().toString(36).substring(2, 9),
      hex: s.hex,
      l: s.l,
      c: s.c,
      h: s.h,
      isBase: idx === 2,
      isLocked: false,
    }));
    baseIndex = 2;
    renderAll();
  }

  function drawWheelBackground() {
    const ctx = wheelCanvas.getContext('2d');
    if (!ctx) return;

    const width = wheelCanvas.width;
    const height = wheelCanvas.height;
    const cx = width / 2;
    const cy = height / 2;
    const radius = width / 2 - 12;

    ctx.clearRect(0, 0, width, height);

    for (let angle = 0; angle < 360; angle += 1) {
      const startAngle = ((angle - 1) * Math.PI) / 180;
      const endAngle = ((angle + 1) * Math.PI) / 180;

      const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
      const hexOuter = oklchToHex(0.68, 0.25, angle);
      const hexInner = oklchToHex(0.92, 0.02, angle);

      grad.addColorStop(0, hexInner);
      grad.addColorStop(0.5, oklchToHex(0.78, 0.16, angle));
      grad.addColorStop(1, hexOuter);

      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();
    }

    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
    ctx.lineWidth = 2;
    ctx.stroke();

    for (let rFrac of [0.33, 0.66, 1.0]) {
      ctx.beginPath();
      ctx.arc(cx, cy, radius * rFrac, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  function polarToCanvas(h: number, c: number) {
    const cx = wheelCanvas.width / 2;
    const cy = wheelCanvas.height / 2;
    const maxRadius = wheelCanvas.width / 2 - 12;
    const r = Math.min(1.0, c / 0.30) * maxRadius;
    const rad = (h * Math.PI) / 180;
    return {
      x: cx + r * Math.cos(rad),
      y: cy + r * Math.sin(rad),
    };
  }

  function canvasToPolar(x: number, y: number) {
    const cx = wheelCanvas.width / 2;
    const cy = wheelCanvas.height / 2;
    const maxRadius = wheelCanvas.width / 2 - 12;
    const dx = x - cx;
    const dy = y - cy;
    let rad = Math.atan2(dy, dx);
    let h = (rad * 180) / Math.PI;
    if (h < 0) h += 360;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const c = Math.min(0.37, Math.max(0.01, (dist / maxRadius) * 0.30));
    return { h, c };
  }

  function renderWheelPins() {
    wheelPinsLayer.innerHTML = '';
    wheelSvgLines.innerHTML = '';

    const baseItem = palette[baseIndex] || palette[0];
    const basePos = polarToCanvas(baseItem.h, baseItem.c);

    let linesSvg = '';
    palette.forEach((item, idx) => {
      const pos = polarToCanvas(item.h, item.c);
      if (idx !== baseIndex) {
        linesSvg += `<line x1="${basePos.x}" y1="${basePos.y}" x2="${pos.x}" y2="${pos.y}" stroke="${item.isLocked ? '#F59E0B' : 'rgba(255, 255, 255, 0.4)'}" stroke-width="1.5" stroke-dasharray="${item.isLocked ? '4 3' : 'none'}" />`;
      }
    });
    wheelSvgLines.innerHTML = linesSvg;

    palette.forEach((item, idx) => {
      const pos = polarToCanvas(item.h, item.c);
      const pin = document.createElement('div');
      pin.className = `wheel-pin ${item.isBase ? 'is-base' : ''} ${item.isLocked ? 'is-locked' : ''}`;
      pin.style.left = `${pos.x}px`;
      pin.style.top = `${pos.y}px`;
      pin.style.backgroundColor = item.hex;

      if (item.isBase) {
        pin.innerHTML = `<span class="base-pin-star">★</span>`;
      } else if (item.isLocked) {
        pin.innerHTML = `<span class="lock-pin-icon">🔒</span>`;
      }

      let isDragging = false;

      const onMouseDown = (e: MouseEvent) => {
        e.preventDefault();
        e.stopPropagation();
        isDragging = true;

        const onMouseMove = (moveEvent: MouseEvent) => {
          if (!isDragging) return;
          const rect = wheelWrapper.getBoundingClientRect();
          const scaleX = wheelCanvas.width / rect.width;
          const scaleY = wheelCanvas.height / rect.height;
          const clickX = (moveEvent.clientX - rect.left) * scaleX;
          const clickY = (moveEvent.clientY - rect.top) * scaleY;

          const { h, c } = canvasToPolar(clickX, clickY);

          if (item.isBase) {
            const deltaH = h - item.h;
            palette.forEach((p, pIdx) => {
              if (pIdx === idx) {
                p.h = h;
                p.c = c;
                p.hex = oklchToHex(p.l, p.c, p.h);
              } else if (!p.isLocked) {
                p.h = (p.h + deltaH + 360) % 360;
                p.hex = oklchToHex(p.l, p.c, p.h);
              }
            });
          } else {
            item.h = h;
            item.c = c;
            item.hex = oklchToHex(item.l, item.c, item.h);
          }

          renderAll();
        };

        const onMouseUp = () => {
          isDragging = false;
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        };

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      };

      pin.addEventListener('mousedown', onMouseDown);
      wheelPinsLayer.appendChild(pin);
    });
  }

  function renderPaletteCards() {
    paletteCardsRow.innerHTML = '';
    paletteCountText.textContent = `${palette.length} Swatches`;

    palette.forEach((item, idx) => {
      const card = document.createElement('div');
      card.className = `swatch-manage-card ${item.isBase ? 'is-base-card' : ''}`;

      const isLight = item.l > 0.6;
      const textContrastColor = isLight ? '#000000' : '#FFFFFF';

      const whiteAudit = auditContrastHex('#FFFFFF', item.hex);
      const apcaScore = whiteAudit ? Math.abs(whiteAudit.apca.lc).toFixed(0) : '0';

      card.innerHTML = `
        <div class="swatch-card-toolbar">
          <button class="card-tool-btn ${item.isLocked ? 'tool-active-lock' : ''}" data-action="lock" title="${item.isLocked ? 'Unlock Swatch' : 'Lock Swatch'}">
            ${item.isLocked ? '🔒' : '🔓'}
          </button>
          <button class="card-tool-btn ${item.isBase ? 'tool-active-base' : ''}" data-action="base" title="Set as Base Color">
            ${item.isBase ? '★ Base' : '☆ Base'}
          </button>
          <div class="reorder-group">
            <button class="card-tool-btn" data-action="move-left" ${idx === 0 ? 'disabled' : ''} title="Move Left">‹</button>
            <button class="card-tool-btn" data-action="move-right" ${idx === palette.length - 1 ? 'disabled' : ''} title="Move Right">›</button>
          </div>
          <button class="card-tool-btn delete-tool-btn" data-action="delete" ${palette.length <= 2 ? 'disabled' : ''} title="Delete Swatch">
            ✕
          </button>
        </div>

        <div class="swatch-color-fill" style="background-color: ${item.hex}">
          <input type="color" value="${item.hex}" class="swatch-native-input" data-action="pick-color" />
          <div class="swatch-fill-info" style="color: ${textContrastColor}">
            <span class="swatch-fill-lc">Lc ${apcaScore}</span>
            <button class="copy-hex-chip" data-action="copy" title="Copy Hex">
              ${item.hex}
            </button>
          </div>
        </div>

        <div class="swatch-controls-block">
          <div class="card-slider-row">
            <span class="card-slider-name">Tone (L)</span>
            <span class="card-slider-val">${(item.l * 100).toFixed(0)}%</span>
          </div>
          <input type="range" min="0.05" max="0.98" step="0.01" value="${item.l}" class="custom-range card-tone-slider" data-action="slider-tone" />

          <div class="hex-edit-box">
            <span class="hex-hash">#</span>
            <input type="text" value="${item.hex.replace(/^#/, '')}" class="card-hex-input" spellcheck="false" data-action="hex-input" />
          </div>

          <div class="swatch-meta-readouts">
            <span>C: ${item.c.toFixed(2)}</span>
            <span>H: ${Math.round(item.h)}°</span>
          </div>
        </div>
      `;

      card.querySelector('[data-action="lock"]')?.addEventListener('click', () => {
        item.isLocked = !item.isLocked;
        renderAll();
      });

      card.querySelector('[data-action="base"]')?.addEventListener('click', () => {
        palette.forEach((p) => (p.isBase = false));
        item.isBase = true;
        baseIndex = idx;
        renderAll();
      });

      card.querySelector('[data-action="move-left"]')?.addEventListener('click', () => {
        if (idx > 0) {
          const temp = palette[idx];
          palette[idx] = palette[idx - 1];
          palette[idx - 1] = temp;
          baseIndex = palette.findIndex((p) => p.isBase);
          renderAll();
        }
      });

      card.querySelector('[data-action="move-right"]')?.addEventListener('click', () => {
        if (idx < palette.length - 1) {
          const temp = palette[idx];
          palette[idx] = palette[idx + 1];
          palette[idx + 1] = temp;
          baseIndex = palette.findIndex((p) => p.isBase);
          renderAll();
        }
      });

      card.querySelector('[data-action="delete"]')?.addEventListener('click', () => {
        if (palette.length > 2) {
          const wasBase = item.isBase;
          palette.splice(idx, 1);
          if (wasBase) {
            palette[0].isBase = true;
            baseIndex = 0;
          } else {
            baseIndex = palette.findIndex((p) => p.isBase);
          }
          renderAll();
        }
      });

      card.querySelector('[data-action="copy"]')?.addEventListener('click', () => {
        navigator.clipboard.writeText(item.hex);
        const chip = card.querySelector('[data-action="copy"]') as HTMLElement;
        const prev = chip.textContent;
        chip.textContent = 'Copied!';
        setTimeout(() => {
          chip.textContent = prev;
        }, 1500);
      });

      const toneSlider = card.querySelector('[data-action="slider-tone"]') as HTMLInputElement;
      toneSlider?.addEventListener('input', () => {
        item.l = parseFloat(toneSlider.value);
        item.hex = oklchToHex(item.l, item.c, item.h);
        renderAll();
      });

      const nativePick = card.querySelector('[data-action="pick-color"]') as HTMLInputElement;
      nativePick?.addEventListener('input', () => {
        const ok = hexToOklch(nativePick.value);
        if (ok) {
          item.hex = nativePick.value.toUpperCase();
          item.l = ok.l;
          item.c = ok.c;
          item.h = ok.h;
          renderAll();
        }
      });

      const hexInput = card.querySelector('[data-action="hex-input"]') as HTMLInputElement;
      hexInput?.addEventListener('input', () => {
        const val = hexInput.value.trim();
        if (/^[0-9A-Fa-f]{6}$/.test(val)) {
          const fullHex = `#${val}`.toUpperCase();
          const ok = hexToOklch(fullHex);
          if (ok) {
            item.hex = fullHex;
            item.l = ok.l;
            item.c = ok.c;
            item.h = ok.h;
            renderAll();
          }
        }
      });

      paletteCardsRow.appendChild(card);
    });
  }

  function updateSidebarSliders() {
    const base = palette[baseIndex] || palette[0];
    sliderL.value = base.l.toFixed(2);
    sliderC.value = base.c.toFixed(3);
    sliderH.value = Math.round(base.h).toString();

    valL.textContent = base.l.toFixed(2);
    valC.textContent = base.c.toFixed(3);
    valH.textContent = `${Math.round(base.h)}°`;
    baseColorBadge.textContent = base.hex;
    baseColorBadge.style.backgroundColor = base.hex;
    baseColorBadge.style.color = base.l > 0.6 ? '#000000' : '#FFFFFF';
  }

  function updateBottomPanels() {
    const base = palette[baseIndex] || palette[0];
    const baseHex = base.hex;

    const onWhite = auditContrastHex(baseHex, '#FFFFFF');
    const onBlack = auditContrastHex(baseHex, '#0A0D14');

    if (onWhite) {
      metricWcagWhite.textContent = `${onWhite.wcag.ratio.toFixed(2)}:1`;
      metricApcaWhite.textContent = `${onWhite.apca.lc > 0 ? '+' : ''}${onWhite.apca.lc.toFixed(1)}`;
      badgesWhite.innerHTML = `
        <span class="badge ${onWhite.wcag.normal_aa ? 'badge-pass' : 'badge-fail'}">AA: ${onWhite.wcag.normal_aa ? 'PASS' : 'FAIL'}</span>
        <span class="badge ${onWhite.apca.body_text ? 'badge-pass' : 'badge-fail'}">APCA: ${onWhite.apca.body_text ? 'PASS' : 'FAIL'}</span>
      `;
    }

    if (onBlack) {
      metricWcagBlack.textContent = `${onBlack.wcag.ratio.toFixed(2)}:1`;
      metricApcaBlack.textContent = `${onBlack.apca.lc > 0 ? '+' : ''}${onBlack.apca.lc.toFixed(1)}`;
      badgesBlack.innerHTML = `
        <span class="badge ${onBlack.wcag.normal_aa ? 'badge-pass' : 'badge-fail'}">AA: ${onBlack.wcag.normal_aa ? 'PASS' : 'FAIL'}</span>
        <span class="badge ${onBlack.apca.body_text ? 'badge-pass' : 'badge-fail'}">APCA: ${onBlack.apca.body_text ? 'PASS' : 'FAIL'}</span>
      `;
    }

    const whiteAudit = auditContrastHex('#FFFFFF', baseHex);
    const blackAudit = auditContrastHex('#000000', baseHex);
    const whiteScore = whiteAudit ? Math.abs(whiteAudit.apca.lc) : 0;
    const blackScore = blackAudit ? Math.abs(blackAudit.apca.lc) : 0;

    if (whiteScore >= blackScore) {
      inkNameText.textContent = `White Ink (#FFFFFF) — Lc ${whiteScore.toFixed(1)}`;
      inkDot.style.backgroundColor = '#FFFFFF';
    } else {
      inkNameText.textContent = `Dark Ink (#0A0D14) — Lc ${blackScore.toFixed(1)}`;
      inkDot.style.backgroundColor = '#0A0D14';
    }

    const tokens = generateDesignTokens(baseHex);
    if (tokens) {
      previewBtnBrand.style.backgroundColor = tokens.light['--brand'];
      previewBtnBrand.style.color = '#FFFFFF';
      previewBtnSubtle.style.backgroundColor = tokens.light['--surface-2'];
      previewBtnSubtle.style.color = tokens.light['--ink'];
      previewBtnSubtle.style.border = `1px solid ${tokens.light['--line']}`;
      previewCardBox.style.backgroundColor = tokens.light['--surface'];
      previewCardBox.style.border = `1px solid ${tokens.light['--line']}`;
      previewCardBadge.style.backgroundColor = tokens.light['--brand'];
      previewCardBadge.style.color = '#FFFFFF';

      const formatted = exportTokens(tokens, currentFormat as any);
      tokensCodeOutput.textContent = formatted;
    }
  }

  function applyHarmonyRule() {
    const base = palette[baseIndex] || palette[0];
    const swatches = generateHarmony(base.hex, currentHarmony as any, palette.length);

    palette.forEach((p, idx) => {
      if (!p.isLocked && idx !== baseIndex && swatches[idx]) {
        p.hex = swatches[idx].hex;
        p.l = swatches[idx].l;
        p.c = swatches[idx].c;
        p.h = swatches[idx].h;
      }
    });
  }

  function renderAll() {
    drawWheelBackground();
    renderWheelPins();
    renderPaletteCards();
    updateSidebarSliders();
    updateBottomPanels();
  }

  sliderL.addEventListener('input', () => {
    const base = palette[baseIndex] || palette[0];
    base.l = parseFloat(sliderL.value);
    base.hex = oklchToHex(base.l, base.c, base.h);
    renderAll();
  });

  sliderC.addEventListener('input', () => {
    const base = palette[baseIndex] || palette[0];
    base.c = parseFloat(sliderC.value);
    base.hex = oklchToHex(base.l, base.c, base.h);
    renderAll();
  });

  sliderH.addEventListener('input', () => {
    const base = palette[baseIndex] || palette[0];
    const newH = parseFloat(sliderH.value);
    const deltaH = newH - base.h;
    base.h = newH;
    base.hex = oklchToHex(base.l, base.c, base.h);

    palette.forEach((p, idx) => {
      if (idx !== baseIndex && !p.isLocked) {
        p.h = (p.h + deltaH + 360) % 360;
        p.hex = oklchToHex(p.l, p.c, p.h);
      }
    });

    renderAll();
  });

  harmonyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      harmonyButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentHarmony = btn.getAttribute('data-mode') || 'analogous';
      if (currentHarmony !== 'custom') {
        applyHarmonyRule();
      }
      renderAll();
    });
  });

  addSwatchBtn.addEventListener('click', () => {
    if (palette.length < 10) {
      const base = palette[baseIndex] || palette[0];
      const newH = (base.h + palette.length * 36 + 360) % 360;
      const hex = oklchToHex(base.l, base.c, newH);
      palette.push({
        id: Math.random().toString(36).substring(2, 9),
        hex,
        l: base.l,
        c: base.c,
        h: newH,
        isBase: false,
        isLocked: false,
      });
      renderAll();
    }
  });

  randomizeBtn.addEventListener('click', () => {
    const randomH = Math.floor(Math.random() * 360);
    const randomL = 0.45 + Math.random() * 0.35;
    const randomC = 0.12 + Math.random() * 0.15;
    const base = palette[baseIndex] || palette[0];
    base.l = randomL;
    base.c = randomC;
    base.h = randomH;
    base.hex = oklchToHex(base.l, base.c, base.h);

    const swatches = generateHarmony(base.hex, currentHarmony as any, palette.length);
    palette.forEach((p, idx) => {
      if (!p.isLocked && idx !== baseIndex && swatches[idx]) {
        p.hex = swatches[idx].hex;
        p.l = swatches[idx].l;
        p.c = swatches[idx].c;
        p.h = swatches[idx].h;
      }
    });

    renderAll();
  });

  tokenTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tokenTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      currentFormat = tab.getAttribute('data-format') || 'css';
      updateBottomPanels();
    });
  });

  copyTokensBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(tokensCodeOutput.textContent || '');
    const prev = copyTokensBtn.innerHTML;
    copyTokensBtn.innerHTML = `<span>Copied!</span>`;
    setTimeout(() => {
      copyTokensBtn.innerHTML = prev;
    }, 2000);
  });

  downloadTokensBtn.addEventListener('click', () => {
    const text = tokensCodeOutput.textContent || '';
    const extMap: Record<string, string> = {
      css: 'css',
      'tailwind-v4': 'css',
      'tailwind-v3': 'js',
      'figma-tokens': 'json',
      'style-dictionary': 'json',
      swift: 'swift',
      'android-xml': 'xml',
    };
    const ext = extMap[currentFormat] || 'txt';
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `auracolor-tokens.${ext}`;
    a.click();
    URL.revokeObjectURL(url);
  });

  imageFileInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const ctx = extractCanvas.getContext('2d');
        if (!ctx) return;
        extractCanvas.width = 100;
        extractCanvas.height = 100;
        ctx.drawImage(img, 0, 0, 100, 100);
        const data = ctx.getImageData(0, 0, 100, 100).data;

        let rSum = 0, gSum = 0, bSum = 0, count = 0;
        for (let i = 0; i < data.length; i += 16) {
          rSum += data[i];
          gSum += data[i + 1];
          bSum += data[i + 2];
          count++;
        }

        const r = Math.round(rSum / count);
        const g = Math.round(gSum / count);
        const b = Math.round(bSum / count);
        const toHex = (n: number) => n.toString(16).padStart(2, '0');
        const extractedHex = `#${toHex(r)}${toHex(g)}${toHex(b)}`.toUpperCase();

        const ok = hexToOklch(extractedHex);
        if (ok) {
          const base = palette[baseIndex] || palette[0];
          base.hex = extractedHex;
          base.l = ok.l;
          base.c = ok.c;
          base.h = ok.h;
          applyHarmonyRule();
          renderAll();
        }
      };
      img.src = event.target?.result as string;
    };
    reader.readAsDataURL(file);
  });

  initDefaultPalette();
</script>

