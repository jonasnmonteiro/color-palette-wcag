---
---

<div class="studio-wrapper" id="aura-studio-app">
  <!-- Toast Notification -->
  <div id="studio-toast" class="studio-toast">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 6L9 17l-5-5"></path>
    </svg>
    <span id="studio-toast-msg">Link copiado com sucesso!</span>
  </div>

  <!-- Top Global Header Bar: Compliance Score, Presets Toggle & Share -->
  <div class="studio-top-toolbar glass-panel">
    <div class="toolbar-left">
      <div class="health-status-badge" id="global-health-badge">
        <span class="health-dot"></span>
        <span id="global-health-text">Paleta 100% WCAG AA & APCA Otimizada</span>
      </div>
      <div class="gamut-summary-pill" id="gamut-summary-badge">
        <span>Display P3 & sRGB Validado</span>
      </div>
    </div>

    <div class="toolbar-right">
      <button class="btn-action-pill" id="toggle-presets-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Paletas de Tendência</span>
      </button>
      <button class="btn-action-pill btn-share-pill" id="share-palette-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span>Compartilhar Paleta</span>
      </button>
    </div>
  </div>

  <!-- Expandable Curated Trend Presets Drawer -->
  <div class="glass-panel presets-drawer" id="presets-drawer">
    <div class="presets-header">
      <div>
        <h3 class="presets-title">Paletas de Tendência Curadas (OKLCH Perceptual)</h3>
        <p class="presets-sub">Selecione uma harmonia balanceada para carregar instantaneamente no estúdio e nos testes de contraste</p>
      </div>
      <button class="close-presets-btn" id="close-presets-btn">✕</button>
    </div>
    <div class="presets-grid" id="presets-grid"></div>
  </div>

  <!-- Top Split Section: Cor Base (Color Wheel) & A Paleta (Swatch Cards) -->
  <div class="studio-main-grid">
    <!-- Left Card: COR BASE / Chromatic Wheel -->
    <div class="glass-panel wheel-card-box">
      <div class="card-top-title">
        <span class="card-tag-title">COR BASE</span>
        <div class="harmony-rule-pill" id="current-harmony-label">Análogo</div>
      </div>

      <!-- Color Wheel Canvas, Center Hub & Interactive Pins -->
      <div class="wheel-outer-container">
        <div class="wheel-interactive-stage" id="wheel-interactive-stage">
          <canvas id="wheel-canvas" width="600" height="600" class="chromatic-canvas"></canvas>
          <svg id="wheel-svg-lines" class="chromatic-svg-overlay"></svg>
          <div id="wheel-pins-layer" class="chromatic-pins-layer"></div>
          <div class="wheel-center-hub"></div>
        </div>
      </div>

      <!-- Active Base Hex Readout & Quick Actions -->
      <div class="base-control-bar">
        <div class="base-swatch-box">
          <div class="base-color-square" id="base-color-square">
            <input type="color" id="base-native-picker" value="#3B82F6" class="hidden-native-picker" />
          </div>
          <div class="base-hex-display">
            <span class="base-hex-hash">#</span>
            <input type="text" id="base-hex-input" value="3B82F6" class="base-hex-field" spellcheck="false" maxlength="6" />
          </div>
        </div>

        <div class="base-buttons-row">
          <button class="btn-action-pill" id="eyedropper-btn" title="Pick color from screen">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 11l-8-8-8.5 8.5a2.12 2.12 0 0 0 0 3l2 2a2.12 2.12 0 0 0 3 0L16 8l3 3z"></path>
              <path d="M18 13l4 4-2 2-4-4"></path>
              <circle cx="2" cy="22" r="1"></circle>
            </svg>
            Conta-gotas
          </button>
          <button class="btn-action-pill" id="randomize-palette-btn" title="Generate random harmonic palette">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 3 21 3 21 8"></polyline>
              <line x1="4" y1="20" x2="21" y2="3"></line>
              <polyline points="21 16 21 21 16 21"></polyline>
              <line x1="15" y1="15" x2="21" y2="21"></line>
              <line x1="4" y1="4" x2="9" y2="9"></line>
            </svg>
            Aleatória
          </button>
        </div>
      </div>

      <!-- Harmony Mode Carousel Buttons -->
      <div class="harmony-modes-wrapper">
        <label class="sub-label">Regra Harmônica (OKLCH)</label>
        <div class="harmony-tags-carousel" id="harmony-buttons">
          <button class="harmony-tag-btn active" data-mode="analogous">
            <span class="harmony-icon">◐</span>
            <span>Análogo</span>
          </button>
          <button class="harmony-tag-btn" data-mode="monochromatic">
            <span class="harmony-icon">◼</span>
            <span>Monocromático</span>
          </button>
          <button class="harmony-tag-btn" data-mode="triadic">
            <span class="harmony-icon">▲</span>
            <span>Tríade</span>
          </button>
          <button class="harmony-tag-btn" data-mode="complementary">
            <span class="harmony-icon">◓</span>
            <span>Complementar</span>
          </button>
          <button class="harmony-tag-btn" data-mode="split-complementary">
            <span class="harmony-icon">⑃</span>
            <span>Split Comp</span>
          </button>
          <button class="harmony-tag-btn" data-mode="tetradic">
            <span class="harmony-icon">✣</span>
            <span>Tetradic</span>
          </button>
          <button class="harmony-tag-btn" data-mode="square">
            <span class="harmony-icon">◆</span>
            <span>Quadrado</span>
          </button>
          <button class="harmony-tag-btn" data-mode="custom">
            <span class="harmony-icon">✦</span>
            <span>Livre (Custom)</span>
          </button>
        </div>
      </div>

      <!-- Image Extraction Dropzone -->
      <div class="image-extractor-box">
        <label class="image-dropzone-pill" for="image-file-input">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>Carregar Imagem para Extrair Paleta (K-Means)</span>
          <input type="file" id="image-file-input" accept="image/*" class="file-hidden-input" />
        </label>
        <canvas id="extract-canvas" style="display:none;"></canvas>
      </div>
    </div>

    <!-- Right Card: A PALETA / Swatches List -->
    <div class="glass-panel palette-card-box">
      <div class="card-top-title">
        <span class="card-tag-title">A PALETA</span>
        <div class="palette-top-tools">
          <span class="drag-hint-pill">Arraste para reordenar</span>
        </div>
      </div>

      <!-- Vision Mode / CVD Simulator Bar -->
      <div class="cvd-selector-container">
        <div class="cvd-header-meta">
          <span class="sub-label">Simulação de Daltonismo (CVD)</span>
          <span class="cvd-active-status" id="cvd-active-label">Visão Padrão</span>
        </div>
        <div class="cvd-modes-buttons" id="cvd-mode-buttons">
          <button class="cvd-mode-btn active" data-cvd="normal">Padrão</button>
          <button class="cvd-mode-btn" data-cvd="protanopia">Protanopia <span class="cvd-sub-badge">Sem L</span></button>
          <button class="cvd-mode-btn" data-cvd="deuteranopia">Deuteranopia <span class="cvd-sub-badge">Sem M</span></button>
          <button class="cvd-mode-btn" data-cvd="tritanopia">Tritanopia <span class="cvd-sub-badge">Sem S</span></button>
          <button class="cvd-mode-btn" data-cvd="achromatopsia">Acromatopsia <span class="cvd-sub-badge">Mono</span></button>
        </div>
      </div>

      <!-- Vertical List of Swatches Cards with Drag and Drop -->
      <div class="palette-swatches-list" id="palette-swatches-list"></div>

      <!-- Dashed Container to Add Swatch -->
      <button class="add-swatch-dashed-card" id="add-swatch-btn" type="button" title="Adicionar nova cor à paleta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Adicionar Cor</span>
      </button>

      <!-- Footer Action -->
      <div class="palette-footer-row">
        <a href="#token-exporter-section" class="btn-primary export-anchor-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Exportar Tokens de Design
        </a>
      </div>
    </div>
  </div>

  <!-- CVD Multimodal Spectral Matrix Comparison Panel -->
  <div class="glass-panel cvd-matrix-panel">
    <div class="card-header">
      <div>
        <h2 class="card-title">Matriz Multimodal de Daltonismo (Machado 2009 / Brettel 1997)</h2>
        <p class="card-subtitle">Auditoria visual e espectral simultânea de toda a paleta ativa nos 4 espaços de deficiência visual</p>
      </div>
      <span class="badge badge-neutral" id="cvd-matrix-badge">Simulação 100% Espectral</span>
    </div>
    <div class="cvd-matrix-grid" id="cvd-matrix-grid"></div>
  </div>

  <!-- Interactive Live UI Component Mockup Showcase (Light/Dark Mode Sync) -->
  <div class="glass-panel ui-showcase-panel">
    <div class="card-header">
      <div>
        <h2 class="card-title">Preview de UI & Design System ao Vivo</h2>
        <p class="card-subtitle">Aplicação dinâmica em componentes reais de interface com suporte a Dark/Light Mode e simulação espectral de Daltonismo</p>
      </div>
      <div class="ui-mockup-controls">
        <div class="theme-toggle-group">
          <button class="theme-toggle-btn active" id="mockup-theme-dark" data-theme="dark">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            Dark Mode
          </button>
          <button class="theme-toggle-btn" id="mockup-theme-light" data-theme="light">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            Light Mode
          </button>
        </div>
      </div>
    </div>

    <!-- UI Mockup Canvas Area -->
    <div class="mockup-canvas-wrapper" id="mockup-canvas-container">
      <!-- App Header Bar -->
      <div class="mockup-app-bar" id="mockup-app-bar">
        <div class="mockup-brand-logo">
          <div class="mockup-logo-mark" id="mockup-logo-dot"></div>
          <span class="mockup-brand-title">Apexmira Analytics</span>
        </div>
        <div class="mockup-nav-links">
          <span class="mockup-nav-item active" id="mockup-nav-active">Overview</span>
          <span class="mockup-nav-item">Vendas</span>
          <span class="mockup-nav-item">Clientes</span>
        </div>
        <div class="mockup-user-avatar" id="mockup-avatar">AD</div>
      </div>

      <!-- KPI Metrics Cards Row -->
      <div class="mockup-kpi-grid">
        <div class="mockup-kpi-card" id="mockup-kpi-1">
          <span class="kpi-label">Receita Líquida (MRR)</span>
          <div class="kpi-value-row">
            <span class="kpi-num">R$ 148.920</span>
            <span class="kpi-growth-badge" id="mockup-growth-badge">+24.5%</span>
          </div>
          <div class="kpi-bar-track">
            <div class="kpi-bar-fill" id="mockup-bar-fill-1" style="width: 78%;"></div>
          </div>
        </div>

        <div class="mockup-kpi-card" id="mockup-kpi-2">
          <span class="kpi-label">Acessibilidade Média</span>
          <div class="kpi-value-row">
            <span class="kpi-num" id="mockup-wcag-ratio-display">9.4 : 1</span>
            <span class="kpi-status-badge" id="mockup-status-badge">AAA Pass</span>
          </div>
          <div class="kpi-bar-track">
            <div class="kpi-bar-fill" id="mockup-bar-fill-2" style="width: 94%;"></div>
          </div>
        </div>

        <div class="mockup-kpi-card" id="mockup-kpi-3">
          <span class="kpi-label">Taxa de Conversão PDV</span>
          <div class="kpi-value-row">
            <span class="kpi-num">18.6%</span>
            <span class="kpi-growth-badge" id="mockup-accent-badge">+5.2%</span>
          </div>
          <div class="kpi-bar-track">
            <div class="kpi-bar-fill" id="mockup-bar-fill-3" style="width: 62%;"></div>
          </div>
        </div>
      </div>

      <!-- Main Content Split: E-Commerce / Feature Card + Form Controls -->
      <div class="mockup-content-grid">
        <!-- Card 1: Interactive Product Feature Card -->
        <div class="mockup-feature-box" id="mockup-feature-box">
          <div class="feature-tag-row">
            <span class="mockup-pill-badge" id="mockup-pill-tag">DESTAQUE PRO</span>
            <span class="feature-stars">Nota 4.9 / 5.0</span>
          </div>
          <h4 class="feature-card-heading">Colorust Perceptual Studio</h4>
          <p class="feature-card-summary">
            Design tokens padronizados em OKLCH com conformidade legal WCAG 2.1 AA e WCAG 3.0 APCA Lc garantidos em tempo de compilação.
          </p>
          <div class="feature-action-row">
            <button class="mockup-btn-brand" id="mockup-main-btn">
              Ação Primária
            </button>
            <button class="mockup-btn-outline" id="mockup-sec-btn">
              Secundário
            </button>
          </div>
        </div>

        <!-- Card 2: Interactive Form & Input Controls -->
        <div class="mockup-form-box" id="mockup-form-box">
          <div class="form-row-group">
            <label class="form-field-label">Token Semântico</label>
            <div class="form-input-wrapper">
              <input type="text" value="--color-brand-primary" class="mockup-text-input" id="mockup-text-input" readonly />
              <button class="mockup-input-btn" id="mockup-input-btn">Copiar</button>
            </div>
          </div>

          <div class="form-switches-row">
            <div class="mockup-badge-pill" id="mockup-pill-active">Ativo</div>
            <div class="mockup-badge-pill" id="mockup-pill-neutral">Pendente</div>
            <div class="mockup-badge-pill" id="mockup-pill-accent">Verificado</div>
          </div>

          <div class="form-progress-box">
            <div class="progress-label-row">
              <span>Saturação de Gamut sRGB</span>
              <span id="mockup-gamut-val">99.8%</span>
            </div>
            <div class="mockup-gradient-bar" id="mockup-gradient-bar"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Section: Auditor Gates, Dual Inks, and Multi-Format Token Exporter -->
  <div class="studio-bottom-grid" id="token-exporter-section">
    <!-- Left Column: Contrast Auditor Gates & Dual Inks -->
    <div class="glass-panel studio-card">
      <div class="card-header">
        <h2 class="card-title">Auditoria de Acessibilidade & APCA</h2>
        <span class="badge badge-pass" id="global-wcag-badge">WCAG 2.1 AA</span>
      </div>

      <div class="contrast-gates-grid">
        <div class="contrast-gate-box" id="gate-on-white">
          <div class="gate-title">Contraste no Branco (#FFFFFF)</div>
          <div class="gate-metrics">
            <div class="gate-metric">
              <span class="metric-val" id="metric-wcag-white">4.5:1</span>
              <span class="metric-label">WCAG 2.1</span>
            </div>
            <div class="gate-metric">
              <span class="metric-val" id="metric-apca-white">-78.2</span>
              <span class="metric-label">APCA Lc</span>
            </div>
          </div>
          <div class="gate-badges" id="badges-white"></div>
        </div>

        <div class="contrast-gate-box" id="gate-on-black">
          <div class="gate-title">Contraste no Escuro (#0A0D14)</div>
          <div class="gate-metrics">
            <div class="gate-metric">
              <span class="metric-val" id="metric-wcag-black">8.4:1</span>
              <span class="metric-label">WCAG 2.1</span>
            </div>
            <div class="gate-metric">
              <span class="metric-val" id="metric-apca-black">+84.5</span>
              <span class="metric-label">APCA Lc</span>
            </div>
          </div>
          <div class="gate-badges" id="badges-black"></div>
        </div>
      </div>

      <div class="ink-recommendation-box">
        <div class="ink-meta">
          <span class="ink-label">Tinta de Texto Ideal (Dual Inks)</span>
          <span class="ink-reason" id="ink-reason-text">Maior legibilidade perceptual calculada</span>
        </div>
        <div class="ink-pill" id="recommended-ink-pill">
          <span class="ink-pill-dot" id="ink-dot"></span>
          <span id="ink-name-text">Tinta Branca (#FFFFFF)</span>
        </div>
      </div>
    </div>

    <!-- Middle & Right Columns Combined: Token Exporter -->
    <div class="glass-panel studio-card exporter-card-span">
      <div class="card-header">
        <div>
          <h2 class="card-title">Exportador de Tokens de Design</h2>
          <p class="card-subtitle">Formatos prontos para produção em CSS, Tailwind v3/v4, Figma DTCG, SwiftUI e Android XML</p>
        </div>
        <button class="btn-secondary copy-btn" id="copy-tokens-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copiar Código
        </button>
      </div>

      <div class="token-tabs" id="token-format-tabs">
        <button class="token-tab active" data-format="css">CSS Variables</button>
        <button class="token-tab" data-format="tailwind-v4">Tailwind v4 (@theme)</button>
        <button class="token-tab" data-format="tailwind-v3">Tailwind v3</button>
        <button class="token-tab" data-format="figma-tokens">Figma DTCG (JSON)</button>
        <button class="token-tab" data-format="style-dictionary">Style Dictionary</button>
        <button class="token-tab" data-format="swift">SwiftUI Color</button>
        <button class="token-tab" data-format="android-xml">Android XML</button>
      </div>

      <div class="code-viewer-container">
        <pre class="code-block"><code id="tokens-code-output">Loading tokens...</code></pre>
      </div>

      <div class="download-footer">
        <button class="btn-primary download-btn" id="download-tokens-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Baixar Arquivo de Tokens
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    auditContrastHex,
    auditCvdContrast,
    exportTokens,
    findGamutCusp,
    generateDesignTokens,
    generateHarmony,
    hexToOklch,
    isInGamut,
    oklchToHex,
    parseHex,
    quantizeImage,
    rgbToHex,
    simulateCvd,
    CvdType,
    initColorustWasm,
  } from '../../../wasm/src/index';

  // Runs the Rust engine when its WebAssembly build is served beside the page,
  // and the TypeScript port when it is not.
  await initColorustWasm(`${import.meta.env.BASE_URL}wasm/`);

  interface PaletteItem {
    id: string;
    hex: string;
    l: number;
    c: number;
    h: number;
    isBase: boolean;
    isLocked: boolean;
  }

  interface CuratedPreset {
    name: string;
    category: string;
    harmony: string;
    hexes: string[];
    tag: string;
  }

  const CURATED_PRESETS: CuratedPreset[] = [
    {
      name: 'Apexmira Tech Neon',
      category: 'Tech / Modern',
      harmony: 'custom',
      hexes: ['#00F0FF', '#7000FF', '#FF007A', '#00FF66', '#181824'],
      tag: 'Tech Neon',
    },
    {
      name: 'Tailwind Modern SaaS',
      category: 'SaaS / Enterprise',
      harmony: 'analogous',
      hexes: ['#0284C7', '#2563EB', '#4F46E5', '#0D9488', '#059669'],
      tag: 'SaaS Blue',
    },
    {
      name: 'Nord Frost Minimal',
      category: 'Nordic / Minimal',
      harmony: 'custom',
      hexes: ['#88C0D0', '#81A1C1', '#5E81AC', '#8FBCBB', '#4C566A'],
      tag: 'Clean Minimal',
    },
    {
      name: 'Catppuccin Macchiato',
      category: 'Pastel / Modern',
      harmony: 'custom',
      hexes: ['#8AADF4', '#F5BDE6', '#C6A0F6', '#ED8796', '#EED49F'],
      tag: 'Aesthetic Soft',
    },
    {
