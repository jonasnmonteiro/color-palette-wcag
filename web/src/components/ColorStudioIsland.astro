        const inGamut = isInGamut({ l: item.l, c: item.c, h: item.h }, 'srgb');
        const cusp = findGamutCusp(item.h, 'srgb');
        const whiteAudit = auditContrastHex('#FFFFFF', displayHex);
        const apcaScore = whiteAudit ? Math.abs(whiteAudit.apca.lc).toFixed(0) : '0';
        const isLight = isLightColor(displayHex);

        card.style.backgroundColor = displayHex;
        card.className = `swatch-solid-card ${item.isBase ? 'swatch-solid-base' : ''} ${isLight ? 'theme-dark-ink' : 'theme-light-ink'}`;

        const hexLabel = card.querySelector('.swatch-solid-hex') as HTMLElement;
        if (hexLabel) hexLabel.textContent = displayHex;

        const cvdTag = card.querySelector('.cvd-tag-pill') as HTMLElement;
        if (cvdTag) {
          cvdTag.textContent = isCvdActive ? `orig: ${item.hex}` : '';
          cvdTag.style.display = isCvdActive ? 'inline-flex' : 'none';
        }

        const lcPill = card.querySelector('.lc-pill') as HTMLElement;
        if (lcPill) lcPill.textContent = `Lc ${apcaScore}`;

        const gamutPill = card.querySelector('.gamut-pill') as HTMLElement;
        if (gamutPill) {
          gamutPill.textContent = inGamut ? 'sRGB' : 'P3';
          gamutPill.title = `Cusp Max Chroma: ${cusp.max_chroma.toFixed(2)}`;
        }

        const toneLabel = card.querySelector('.tone-inline-label') as HTMLElement;
        if (toneLabel) toneLabel.textContent = `Tom: ${(item.l * 100).toFixed(0)}%`;
      };

      const toneRange = card.querySelector('[data-action="slider-tone"]') as HTMLInputElement;
      toneRange?.setAttribute('draggable', 'false');
      toneRange?.addEventListener('dragstart', (e) => {
        e.preventDefault();
        e.stopPropagation();
      });
      toneRange?.addEventListener('mousedown', (e) => {
        card.setAttribute('draggable', 'false');
        e.stopPropagation();
      });
      toneRange?.addEventListener('pointerdown', (e) => {
        card.setAttribute('draggable', 'false');
        e.stopPropagation();
      });
      toneRange?.addEventListener('input', () => {
        item.l = parseFloat(toneRange.value);
        item.hex = oklchToHex(item.l, item.c, item.h);
        updateCardVisuals();
        drawWheelCanvas();
        renderWheelPins();
        renderCvdMatrix();
        updateBaseControls();
        updateMockupUI();
        updateBottomPanels();
        syncHashUrl();
