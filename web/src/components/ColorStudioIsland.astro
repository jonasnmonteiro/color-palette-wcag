            <div class="drag-handle-grip" title="Arrastar para reordenar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="8" cy="6" r="2"></circle>
                <circle cx="16" cy="6" r="2"></circle>
                <circle cx="8" cy="12" r="2"></circle>
                <circle cx="16" cy="12" r="2"></circle>
                <circle cx="8" cy="18" r="2"></circle>
                <circle cx="16" cy="18" r="2"></circle>
              </svg>
            </div>

            <div class="swatch-hex-picker-wrap" title="Clique para escolher cor no seletor">
              <span class="swatch-solid-hex">${displayHex}</span>
              <input type="color" value="${item.hex}" class="hidden-native-picker" data-action="pick-color" />
            </div>

            ${item.isBase ? '<span class="swatch-solid-pill base-tag-pill">Base</span>' : ''}
            ${isCvdActive ? `<span class="swatch-solid-pill cvd-tag-pill">orig: ${item.hex}</span>` : ''}
            <span class="swatch-solid-pill lc-pill">Lc ${apcaScore}</span>
            <span class="swatch-solid-pill gamut-pill" title="Cusp Max Chroma: ${cusp.max_chroma.toFixed(2)}">${inGamut ? 'sRGB' : 'P3'}</span>
          </div>

