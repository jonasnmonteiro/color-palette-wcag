  function loadPresetPalette(preset: CuratedPreset) {
    palette = preset.hexes.map((hex, idx) => {
      const ok = hexToOklch(hex) || { l: 0.6, c: 0.15, h: 200 };
      return {
        id: `preset-${idx}-${Math.random().toString(36).substring(2, 6)}`,
        hex: hex.toUpperCase(),
        l: ok.l,
        c: ok.c,
        h: ok.h,
        isBase: idx === 0,
        isLocked: false,
      };
    });

    baseIndex = 0;
    currentHarmony = preset.harmony;
    harmonyButtons.forEach((b) => {
      if (b.getAttribute('data-mode') === currentHarmony) {
        b.classList.add('active');
      } else {
        b.classList.remove('active');
      }
    });

    syncHashUrl();
    renderAll();
