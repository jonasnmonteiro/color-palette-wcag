  function drawWheelCanvas() {
    const ctx = wheelCanvas.getContext('2d');
    if (!ctx) return;

    const width = wheelCanvas.width;
    const height = wheelCanvas.height;
    const cx = width / 2;
    const cy = height / 2;
    const radius = width / 2 - 16;

    ctx.clearRect(0, 0, width, height);

    for (let angle = 0; angle < 360; angle += 1) {
      const startAngle = ((angle - 1.5) * Math.PI) / 180;
      const endAngle = ((angle + 1.5) * Math.PI) / 180;

      const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
      const hexOuter = oklchToHex(0.68, 0.28, angle);
      const hexInner = oklchToHex(0.95, 0.01, angle);

      grad.addColorStop(0, hexInner);
      grad.addColorStop(0.4, oklchToHex(0.82, 0.14, angle));
      grad.addColorStop(1, hexOuter);

      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();
    }

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.strokeStyle = isLight ? 'rgba(15, 23, 42, 0.25)' : 'rgba(255, 255, 255, 0.25)';
    ctx.lineWidth = 3;
    ctx.stroke();

    for (let frac of [0.33, 0.66, 1.0]) {
      ctx.beginPath();
      ctx.arc(cx, cy, radius * frac, 0, Math.PI * 2);
      ctx.strokeStyle = isLight ? 'rgba(15, 23, 42, 0.08)' : 'rgba(255, 255, 255, 0.08)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }
  }

  function getStageSize() {
    if (!wheelInteractiveStage) {
      return { width: 280, height: 280, cx: 140, cy: 140, maxRadius: 126 };
    }
    const rect = wheelInteractiveStage.getBoundingClientRect();
    const width = rect.width || 280;
    const height = rect.height || 280;
    const cx = width / 2;
    const cy = height / 2;
    const maxRadius = Math.max(20, width / 2 - 14);
    return { width, height, cx, cy, maxRadius };
  }

  function polarToStageCoords(h: number, c: number) {
    const { cx, cy, maxRadius } = getStageSize();
    const r = Math.min(1.0, Math.max(0.05, c / 0.28)) * maxRadius;
    const rad = (h * Math.PI) / 180;
    return {
      x: cx + r * Math.cos(rad),
      y: cy + r * Math.sin(rad),
    };
  }

  function stageCoordsToPolar(x: number, y: number) {
    const { cx, cy, maxRadius } = getStageSize();
    const dx = x - cx;
    const dy = y - cy;
    let rad = Math.atan2(dy, dx);
    let h = (rad * 180) / Math.PI;
    if (h < 0) h += 360;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const c = Math.min(0.37, Math.max(0.01, (dist / maxRadius) * 0.28));
    return { h, c };
  }

  function renderWheelPins() {
    wheelPinsLayer.innerHTML = '';
    wheelSvgLines.innerHTML = '';

    const { width, height, cx, cy } = getStageSize();
    wheelSvgLines.setAttribute('viewBox', `0 0 ${width} ${height}`);
    wheelSvgLines.setAttribute('width', width.toString());
    wheelSvgLines.setAttribute('height', height.toString());

    let linesHtml = '';

    palette.forEach((item) => {
      const pos = polarToStageCoords(item.h, item.c);
      const strokeColor = item.isLocked ? 'var(--color-warning, #F59E0B)' : item.isBase ? 'color-mix(in srgb, var(--text-primary, #FFFFFF) 85%, transparent)' : 'color-mix(in srgb, var(--text-primary, #FFFFFF) 45%, transparent)';
      const strokeWidth = item.isBase ? '2.5' : '1.5';
      const dashArray = item.isLocked ? '4 3' : 'none';

      linesHtml += `<line x1="${cx}" y1="${cy}" x2="${pos.x}" y2="${pos.y}" stroke="${strokeColor}" stroke-width="${strokeWidth}" stroke-dasharray="${dashArray}" />`;
    });

    if (currentHarmony === 'analogous') {
      const sorted = [...palette].sort((a, b) => a.h - b.h);
      for (let i = 0; i < sorted.length - 1; i++) {
        const p1 = polarToStageCoords(sorted[i].h, sorted[i].c);
        const p2 = polarToStageCoords(sorted[i + 1].h, sorted[i + 1].c);
        linesHtml += `<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="color-mix(in srgb, var(--text-primary, #FFFFFF) 35%, transparent)" stroke-width="1.5" stroke-dasharray="2 2" />`;
      }
    } else if (currentHarmony === 'triadic' || currentHarmony === 'tetradic' || currentHarmony === 'square') {
      const sorted = [...palette].sort((a, b) => a.h - b.h);
      for (let i = 0; i < sorted.length; i++) {
        const p1 = polarToStageCoords(sorted[i].h, sorted[i].c);
        const p2 = polarToStageCoords(sorted[(i + 1) % sorted.length].h, sorted[(i + 1) % sorted.length].c);
        linesHtml += `<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="color-mix(in srgb, var(--text-primary, #FFFFFF) 35%, transparent)" stroke-width="1.5" />`;
      }
    }

    wheelSvgLines.innerHTML = linesHtml;

    palette.forEach((item, idx) => {
      const pos = polarToStageCoords(item.h, item.c);
      const pin = document.createElement('div');
      pin.className = `chroma-pin ${item.isBase ? 'pin-is-base' : ''} ${item.isLocked ? 'pin-is-locked' : ''}`;
      pin.style.left = `${pos.x}px`;
      pin.style.top = `${pos.y}px`;
      pin.style.backgroundColor = getEffectiveHex(item.hex);
      pin.setAttribute('data-index', idx.toString());

      if (item.isBase) {
        pin.innerHTML = `<span class="pin-inner-dot"></span>`;
      } else if (item.isLocked) {
        pin.innerHTML = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`;
      }

      wheelPinsLayer.appendChild(pin);
    });
  }

  function applyHarmonyConstellation(newBaseH: number, newBaseC: number) {
    const base = palette[baseIndex] || palette[0];
    base.h = newBaseH;
    base.c = newBaseC;
    base.hex = oklchToHex(base.l, base.c, base.h);

    const N = palette.length;

    if (currentHarmony === 'analogous') {
      const step = 15;
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const offset = (idx - baseIndex) * step;
          p.h = (base.h + offset + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'monochromatic') {
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          p.h = base.h;
          const radialScale = 0.3 + (idx / Math.max(1, N - 1)) * 0.7;
          p.c = Math.min(0.37, Math.max(0.02, base.c * radialScale));
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'triadic') {
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const slot = idx % 3;
          p.h = (base.h + slot * 120 + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'complementary') {
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const isOpposite = idx % 2 === 1;
          p.h = isOpposite ? (base.h + 180 + 360) % 360 : base.h;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'split-complementary') {
      const offsets = [0, 150, 210, 150, 210];
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const off = offsets[idx % offsets.length];
          p.h = (base.h + off + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'tetradic') {
      const offsets = [0, 60, 180, 240, 60];
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const off = offsets[idx % offsets.length];
          p.h = (base.h + off + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    } else if (currentHarmony === 'square') {
      const offsets = [0, 90, 180, 270, 90];
      palette.forEach((p, idx) => {
        if (!p.isLocked && idx !== baseIndex) {
          const off = offsets[idx % offsets.length];
          p.h = (base.h + off + 360) % 360;
          p.c = base.c;
          p.hex = oklchToHex(p.l, p.c, p.h);
        }
      });
    }

    syncHashUrl();
  }

  function setupWheelDragListeners() {
    let isDragging = false;
    let draggedIndex = 0;

    const handlePointerDown = (clientX: number, clientY: number) => {
      const rect = wheelInteractiveStage.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;

      let closestIdx = -1;
      let minDistance = 32;

      palette.forEach((item, idx) => {
        const pos = polarToStageCoords(item.h, item.c);
        const dist = Math.hypot(x - pos.x, y - pos.y);
        if (dist < minDistance) {
          minDistance = dist;
          closestIdx = idx;
        }
      });

      if (closestIdx !== -1) {
        draggedIndex = closestIdx;
      } else {
        draggedIndex = baseIndex;
      }

      isDragging = true;
      handlePointerMove(clientX, clientY);
    };

    const handlePointerMove = (clientX: number, clientY: number) => {
      if (!isDragging) return;

      const rect = wheelInteractiveStage.getBoundingClientRect();
      const stageW = rect.width || 280;
      const stageH = rect.height || 280;
      const x = Math.max(0, Math.min(stageW, clientX - rect.left));
      const y = Math.max(0, Math.min(stageH, clientY - rect.top));

      const { h, c } = stageCoordsToPolar(x, y);

      if (currentHarmony === 'custom') {
        const target = palette[draggedIndex];
        if (!target.isLocked) {
          target.h = h;
          target.c = c;
          target.hex = oklchToHex(target.l, target.c, target.h);
        }
      } else {
        applyHarmonyConstellation(h, c);
      }

      renderAll();
    };

    const handlePointerUp = () => {
      isDragging = false;
    };

    wheelInteractiveStage.addEventListener('mousedown', (e) => {
      e.preventDefault();
      handlePointerDown(e.clientX, e.clientY);

      const onMouseMove = (moveEvent: MouseEvent) => {
        handlePointerMove(moveEvent.clientX, moveEvent.clientY);
      };

      const onMouseUp = () => {
        handlePointerUp();
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
      };

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
    });

    wheelInteractiveStage.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        e.preventDefault();
        const touch = e.touches[0];
        handlePointerDown(touch.clientX, touch.clientY);
      }
    }, { passive: false });

    window.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        const touch = e.touches[0];
        handlePointerMove(touch.clientX, touch.clientY);
      }
    }, { passive: false });

    window.addEventListener('touchend', handlePointerUp);

    window.addEventListener('resize', () => {
      renderWheelPins();
    });
  }

  function isLightColor(hex: string): boolean {
    const rgb = parseHex(hex);
    if (!rgb) return false;
    const r = rgb.r / 255;
    const g = rgb.g / 255;
    const b = rgb.b / 255;
    const rLin = r <= 0.03928 ? r / 12.92 : Math.pow((r + 0.055) / 1.055, 2.4);
    const gLin = g <= 0.03928 ? g / 12.92 : Math.pow((g + 0.055) / 1.055, 2.4);
    const bLin = b <= 0.03928 ? b / 12.92 : Math.pow((b + 0.055) / 1.055, 2.4);
    const L = 0.2126 * rLin + 0.7152 * gLin + 0.0722 * bLin;
    return L > 0.38;
  }

  function renderPaletteCards() {
