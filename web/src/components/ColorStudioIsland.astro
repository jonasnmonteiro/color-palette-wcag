      const nativePicker = card.querySelector('[data-action="pick-color"]') as HTMLInputElement;
      nativePicker?.setAttribute('draggable', 'false');
      nativePicker?.addEventListener('dragstart', (e) => {
        e.preventDefault();
        e.stopPropagation();
      });
      nativePicker?.addEventListener('mousedown', (e) => {
        card.setAttribute('draggable', 'false');
        e.stopPropagation();
      });
      nativePicker?.addEventListener('pointerdown', (e) => {
        card.setAttribute('draggable', 'false');
        e.stopPropagation();
      });
      nativePicker?.addEventListener('input', () => {
        const ok = hexToOklch(nativePicker.value);
        if (ok) {
          item.hex = nativePicker.value.toUpperCase();
          item.l = ok.l;
          item.c = ok.c;
          item.h = ok.h;
          if (toneRange) toneRange.value = item.l.toString();
          updateCardVisuals();
          drawWheelCanvas();
          renderWheelPins();
          renderCvdMatrix();
          updateBaseControls();
          updateMockupUI();
          updateBottomPanels();
          syncHashUrl();
        }
      });

      paletteSwatchesList.appendChild(card);
    });
  }

