---
const currentPath = Astro.url.pathname;
---

<header class="studio-header">
  <div class="container header-container">
    <div class="brand-group">
      <a href="/" class="brand-link">
        <div class="brand-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a7 7 0 0 1 7 7c0 3-2 5-7 13-5-8-7-10-7-13a7 7 0 0 1 7-7z"></path>
          </svg>
        </div>
        <div class="brand-meta">
          <span class="brand-title">Colorust <span class="brand-tag">Studio</span></span>
          <span class="brand-subtitle">Perceptual OKLCH & APCA Engine</span>
        </div>
      </a>
    </div>

    <nav class="nav-links">
      <a href="/" class={`nav-item ${currentPath === '/' ? 'active' : ''}`}>Studio</a>
      <a href="/auditor" class={`nav-item ${currentPath === '/auditor' ? 'active' : ''}`}>Contrast Auditor</a>
      <a href="/tokens" class={`nav-item ${currentPath === '/tokens' ? 'active' : ''}`}>Token Exporter</a>
    </nav>

    <div class="header-actions">
      <button class="btn-secondary theme-toggle-pill" id="theme-toggle-btn" type="button" aria-label="Alternar tema claro ou escuro" title="Alternar tema claro ou escuro">
        <svg class="sun-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="theme-label" id="theme-toggle-label">Tema</span>
      </button>

      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="btn-secondary github-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function getStoredTheme() {
      try {
        const stored = localStorage.getItem('colorust-app-theme');
        if (stored) return stored;
      } catch {}
      return 'dark';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('colorust-app-theme', theme);
      } catch {}
      const label = document.getElementById('theme-toggle-label');
      if (label) {
        label.textContent = theme === 'light' ? 'Claro' : 'Escuro';
      }
      window.dispatchEvent(new CustomEvent('colorust-theme-changed', { detail: { theme } }));
    }

    const currentTheme = getStoredTheme();
    applyTheme(currentTheme);

    window.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('theme-toggle-btn');
      const label = document.getElementById('theme-toggle-label');
      if (label) {
        const theme = document.documentElement.getAttribute('data-theme') || 'dark';
        label.textContent = theme === 'light' ? 'Claro' : 'Escuro';
      }
      toggleBtn?.addEventListener('click', () => {
        const activeTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        const nextTheme = activeTheme === 'light' ? 'dark' : 'light';
        applyTheme(nextTheme);
      });
    });
  })();
</script>

<style>
  .studio-header {
    background: color-mix(in srgb, var(--bg-app, #0A0D14) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-group {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--brand-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-on-accent, #FFFFFF);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--shadow-base, #000000) 25%, transparent);
  }

  .brand-meta {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary, #F3F4F6);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .brand-tag {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--brand-primary) 15%, transparent);
    color: var(--brand-light, #2563EB);
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
  }

  .brand-subtitle {
    font-size: 11px;
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface-elevated);
    padding: 4px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .nav-item {
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--brand-primary) 8%, var(--bg-surface-elevated));
  }

  .nav-item.active {
    color: var(--brand-light, #2563EB);
    background: color-mix(in srgb, var(--brand-primary) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-primary) 35%, transparent);
    font-weight: 700;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .theme-toggle-pill {
    padding: 7px 12px;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    background: var(--bg-surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .theme-toggle-pill:hover {
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    border-color: color-mix(in srgb, var(--text-primary) 20%, transparent);
  }

  .theme-toggle-pill .sun-icon {
    display: inline-block;
  }

  .theme-toggle-pill .moon-icon {
    display: none;
  }

  :global([data-theme="light"]) .theme-toggle-pill .sun-icon {
    display: none;
  }

  :global([data-theme="light"]) .theme-toggle-pill .moon-icon {
    display: inline-block;
  }

  .theme-label {
    font-weight: 600;
    font-size: 12px;
  }

  .github-btn {
    padding: 7px 14px;
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .nav-links, .engine-status {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .header-container {
      height: 56px;
    }
    .brand-icon {
      width: 32px;
      height: 32px;
    }
    .brand-title {
      font-size: 15px;
    }
    .brand-subtitle {
      display: none;
    }
    .github-btn {
      padding: 6px 10px;
      font-size: 12px;
    }
  }
</style>
